"""05010xx.WR1 package facts (Littelfuse 501 series, Revised 12/14/17) in a 4S battery line."""

FUSE = Module("../05010xx.zen")

# Electrical Specifications by Item: rating -> (MPN, nominal resistance, melting I2t at 1 ms).
ROWS = {
    "10A": ("0501010.WR1", "3.62mOhm", 10.385),
    "12A": ("0501012.WR1", "3.11mOhm", 20.341),
    "15A": ("0501015.WR1", "2.5mOhm", 39.7),
    "20A": ("0501020.WR1", "1.94mOhm", 86.36),
}


def part(module):
    parts = module.components().values()
    check(len(parts) == 1, "the package is a bare part: expected one component")
    return parts[0]


def datasheet_limits(module, inputs):
    c = part(module)
    rating = str(c.properties["current_rating"].value).replace(".0", "") + "A"
    check(rating in ROWS, "rating " + rating)
    mpn, cold, i2t = ROWS[rating]
    check(c.mpn == mpn, "MPN " + str(c.mpn) + " for " + rating)
    check(c.manufacturer == "Littelfuse", "manufacturer")
    check(c.prefix == "F", "reference prefix F")
    check(c.type == "fuse", "type")
    check(c.properties["voltage_rating"].matches("32V"), "32 VDC")
    check(c.properties["interrupting_current"].matches("150A"), "150 A at 32 VDC")
    check(c.properties["cold_resistance"].matches(cold), "nominal resistance")
    check(abs(c.properties["melting_i2t"] - i2t) < 1e-3, "melting I2t")
    # The time-current curve: a longer time opens at a lower current.
    p = c.properties
    check(p["opening_current_100s"] < p["opening_current_1s"], "curve order")
    check(p["opening_current_1s"] < p["opening_current_10ms"], "curve order")


def rated_for_the_pack(module, inputs):
    # The interrupting rating holds up to the 32 V rating, above the 17.4 V HV pack.
    c = part(module)
    v = c.pins["1"].voltage.max
    check(v <= c.properties["voltage_rating"].value, "the line exceeds the 32 V rating: " + str(v))


def lines(rating):
    return {
        "rating": rating,
        "P1": Power("PACK_P_" + rating, voltage="0V to 17.4V"),
        "P2": Power("VBAT_" + rating, voltage="0V to 17.4V"),
    }


TestBench(
    name="05010xx",
    module=FUSE,
    test_cases={"4s_10a": lines("10A"), "4s_12a": lines("12A"), "4s_15a": lines("15A"), "4s_20a": lines("20A")},
    checks=[datasheet_limits, rated_for_the_pack],
)
