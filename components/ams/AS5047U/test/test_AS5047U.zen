"""Datasheet requirements of the AS5047U package in 3.3 V mode (DS v1-00)."""

load("@stdlib/interfaces.zen", "Spi")

AS5047U = Module("../AS5047U.zen")


def net_of(module, part, pin):
    for name, ports in module.nets().items():
        for path, p in ports:
            if path.endswith("." + part) and p == pin:
                return name
    error(part + "." + pin + " is not connected")


def orderable_part(module, inputs):
    # Figure 64 (ordering information): AS5047U-HTSM = TSSOP-14, tape and reel
    c = module.components()["AS5047U"]
    check(c.mpn == "AS5047U-HTSM", "MPN must be AS5047U-HTSM, got " + str(c.mpn))
    check(c.prefix == "IC", "reference prefix must be IC")


def test_pin_is_grounded(module, inputs):
    # Figure 4, pin 5: "Test pin (connect to ground)"
    check(net_of(module, "AS5047U", "TEST") == "GND", "TEST must be tied to GND")


def supply_pins_tied(module, inputs):
    # Figure 11, 3.3 V operation: VDD and VDD3V3 on the same supply
    check(
        net_of(module, "AS5047U", "VDD") == net_of(module, "AS5047U", "VDD3V3"),
        "VDD and VDD3V3 must be tied in 3.3 V mode",
    )


def unused_outputs_open(module, inputs):
    # Figure 4, note 5: U, V, W/PWM and I/PWM are outputs; unused, they stay open (no-connect nets
    # carry no name, so the four share the unnamed entry of nets(): nothing else may be on it)
    unused = ["U", "V", "W/PWM", "I/PWM"]
    for pin in unused:
        for path, p in module.nets()[net_of(module, "AS5047U", pin)]:
            check(path.endswith(".AS5047U") and p in unused, pin + " shares a net with " + path + "." + p)


TestBench(
    name="AS5047U_3V3_mode",
    module=AS5047U,
    test_cases={
        "default": {
            "VDD": Power("VDD", voltage="3.3V"),
            "GND": Ground("GND"),
            "SPI": Spi("SPI"),
            "A": Net("A"),
            "B": Net("B"),
        },
    },
    checks=[orderable_part, test_pin_is_grounded, supply_pins_tied, unused_outputs_open],
)
