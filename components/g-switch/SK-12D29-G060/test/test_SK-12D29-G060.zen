"""Package-level facts of the SK-12D29-G060 (G-Switch drawing SK-12D29-GXXX, 2016-05-29)."""

SK12D29 = Module("../SK-12D29-G060.zen")


def part(module):
    parts = module.components().values()
    check(len(parts) == 1, "the package is a bare part: expected one component")
    return parts[0]


def net_of(module, pin):
    for name, ports in module.nets().items():
        for _, p in ports:
            if p == pin:
                return name
    error(pin + " is not connected")


def common_is_centre_pin(module, inputs):
    # SCHEMATIC (non-shorting): the centre pin (2) is the common, joined to pin 1 or pin 3.
    c = part(module)
    check(net_of(module, "COM") == "COMMON", "COM")
    check(net_of(module, "A") == "THROW_A", "A")
    check(net_of(module, "B") == "THROW_B", "B")
    check(len(c.pins) == 3, "three electrical pins; the frame legs are mechanical pads")


def ratings(module, inputs):
    # G-Switch Specification: DC 24 V 1.0 A.
    c = part(module)
    check(c.mpn == "SK-12D29-G060", "MPN")
    check(c.manufacturer == "G-Switch", "manufacturer")
    check(c.prefix == "SW", "reference prefix must be SW")
    check(c.properties["voltage"].matches("24V"), "DC 24 V rating")
    check(c.properties["current"].matches("1A"), "1.0 A rating")


TestBench(
    name="SK-12D29-G060",
    module=SK12D29,
    test_cases={"default": {"COM": Net("COMMON"), "A": Net("THROW_A"), "B": Net("THROW_B")}},
    checks=[common_is_centre_pin, ratings],
)
