"""Pin table of the GT-USB-7010ASV drawing (rev A0): contacts on the right ios."""

load("@stdlib/interfaces.zen", "Usb2")

USBC = Module("../GT-USB-7010ASV.zen")


def ports_of(module, net):
    return sorted([pin for _, pin in module.nets()[net]])


def contacts(module, inputs):
    check(ports_of(module, "VBUS") == ["VBUS"], "VBUS io must carry the VBUS contacts (A4/B9, B4/A9)")
    check(ports_of(module, "GND") == ["GND"], "GND io must carry the GND contacts (A1/B12, B1/A12)")
    check(ports_of(module, "SHIELD") == ["SHIELD"], "SHIELD io must carry the four shell tabs")
    check(ports_of(module, "USB_D_P") == ["D+"], "USB D.P must carry D+ (A6, B6)")
    check(ports_of(module, "USB_D_N") == ["D-"], "USB D.N must carry D- (A7, B7)")


def orientation_pins_separate(module, inputs):
    # Each plug orientation uses one CC and one SBU contact: they stay separate ios.
    for net in ["CC1", "CC2", "SBU1", "SBU2"]:
        check(ports_of(module, net) == [net], net + " must be its own io")


def part_identity(module, inputs):
    c = module.components()["GT-USB-7010ASV"]
    check(c.mpn == "GT-USB-7010ASV", "MPN must be GT-USB-7010ASV")
    check(c.prefix == "U", "designator prefix must be U")


TestBench(
    name="GT_USB_7010ASV_pins",
    module=USBC,
    test_cases={
        "default": {
            "VBUS": Power("VBUS", voltage="5V"),
            "GND": Ground("GND"),
            "SHIELD": Net("SHIELD"),
            "CC1": Net("CC1"),
            "CC2": Net("CC2"),
            "SBU1": Net("SBU1"),
            "SBU2": Net("SBU2"),
            "USB": Usb2("USB"),
        },
    },
    checks=[contacts, orientation_pins_separate, part_identity],
)
