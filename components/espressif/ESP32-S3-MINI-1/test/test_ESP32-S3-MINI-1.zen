"""ESP32-S3-MINI-1 package facts (Espressif datasheet v1.7) and its supply on a 3.3 V buck rail."""

load("@stdlib/interfaces.zen", "DiffPair", "Usb2")

MODULE = Module("../ESP32-S3-MINI-1.zen")

GPIOS = [
    "IO0",
    "IO1",
    "IO2",
    "IO3",
    "IO4",
    "IO5",
    "IO6",
    "IO7",
    "IO8",
    "IO9",
    "IO10",
    "IO11",
    "IO12",
    "IO13",
    "IO14",
    "IO15",
    "IO16",
    "IO17",
    "IO18",
    "IO21",
    "IO26",
    "IO33",
    "IO34",
    "IO35",
    "IO36",
    "IO37",
    "IO38",
    "IO39",
    "IO40",
    "IO41",
    "IO42",
    "IO43",
    "IO44",
    "IO45",
    "IO46",
    "IO47",
    "IO48",
]

# Table 6-4: the highest peak, 802.11b TX at 20.5 dBm; Table 6-2: the supply must deliver 0.5 A.
TX_PEAK_A = 0.355
SUPPLY_MIN_A = 0.5


def part(module):
    return module.components()["ESP32-S3-MINI-1"]


def orderable_part(module, inputs):
    c = part(module)
    check(c.mpn == "ESP32-S3-MINI-1-N8", "MPN must be ESP32-S3-MINI-1-N8, got " + str(c.mpn))
    check(c.manufacturer == "Espressif Systems", "manufacturer")
    check(c.prefix == "U", "reference prefix must be U")


def pinout(module, inputs):
    # Table 3-1: 3V3, EN, USB_D-/USB_D+ (IO19/IO20), TXD0/RXD0 (GPIO43/44), 37 other GPIOs, GND.
    pins = part(module).pins
    want = ["3V3", "EN", "GND", "RXD0", "TXD0", "USB_D+", "USB_D-"] + [g for g in GPIOS if g not in ["IO43", "IO44"]]
    check(sorted(pins.keys()) == sorted(want), "pins: " + str(sorted(pins.keys())))
    check(pins["USB_D+"].name == "D_P", "USB_D+ (IO20, pad 24) must be the USB D+ io")
    check(pins["USB_D-"].name == "D_N", "USB_D- (IO19, pad 23) must be the USB D- io")
    check(pins["TXD0"].name == "IO43", "TXD0 is GPIO43")
    check(pins["RXD0"].name == "IO44", "RXD0 is GPIO44")
    check(pins["EN"].name == "EN", "EN must be the EN io")


def supply(module, inputs):
    # Table 6-2: VDD33 3.0-3.6 V; the rail's declared range must sit inside it.
    v = part(module).pins["3V3"].voltage
    check(v.min >= 3.0 and v.max <= 3.6, "3V3 outside 3.0-3.6 V: " + str(v))
    check(TX_PEAK_A < SUPPLY_MIN_A, "the 0.5 A supply minimum covers the 355 mA TX peak")


CASE = {
    "V3V3": Power("V3V3", voltage="3.284V to 3.346V"),
    "GND": Ground("GND"),
    "EN": Net("EN"),
    "USB": Usb2(D=DiffPair(P=Net("D_P"), N=Net("D_N"))),
}
for g in GPIOS:
    CASE[g] = Net(g)

TestBench(
    name="ESP32_S3_MINI_1",
    module=MODULE,
    test_cases={"l6981c33_rail": CASE},
    checks=[orderable_part, pinout, supply],
)
