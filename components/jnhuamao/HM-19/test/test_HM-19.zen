"""Package-level facts of the HM-19 (JNHuaMao HM Bluetooth module datasheet V107)."""

load("@stdlib/interfaces.zen", "Uart")

HM19 = Module("../HM-19.zen")


def part(module):
    parts = module.components().values()
    check(len(parts) == 1, "the package is a bare module: expected one component")
    return parts[0]


def pads_on(module, net):
    return sorted([pin for _, pin in module.nets().get(net, [])])


def terminal_functions(module, inputs):
    # V107 6.8 p11-12: 9 VCC, 10 NC or VCC (tied to VCC, as in the 6.5 schematic), 12 GND,
    # 2 UART_TX, 4 UART_RX, 1 UART_RTS, 3 UART_CTS, 11 RESETB, 8 KEY, 13-16 PIO3-PIO0.
    pins = part(module).pins
    check(pins["VCC"].name == "V3V3", "VCC (pins 9 and 10) must be on the VCC io")
    check(pins["GND"].name == "GND", "GND (pin 12) must be on the GND io")
    check(pins["UART_TX"].name == "UART_TX", "UART_TX (pin 2) must be UART.TX")
    check(pins["UART_RX"].name == "UART_RX", "UART_RX (pin 4) must be UART.RX")
    check(pins["PIO1"].name == "LED", "PIO1 (pin 15, System LED) must be the PIO1 io")
    check(pins["PIO0"].name == "KEY_PIO0", "PIO0 (pin 16) must be the PIO0 io")
    named = [p for p in pins.keys() if p != "NC"]
    check(len(named) == 12, "12 functional pins besides the NC pins 5, 6 and 7, got " + str(sorted(pins.keys())))


def identity(module, inputs):
    c = part(module)
    check(c.mpn == "HM-19", "MPN")
    check(c.manufacturer == "JNHuaMao", "manufacturer")
    check(c.prefix == "U", "reference prefix must be U")


TestBench(
    name="HM-19",
    module=HM19,
    test_cases={
        # The vendor schematic's supply (V107 6.5: 3V3), inside VDD 2.1-3.7 V (section 3).
        "vendor_3v3": {
            "VCC": Power("V3V3", voltage="3.3V"),
            "GND": Ground("GND"),
            "UART": Uart(TX=Net("UART_TX"), RX=Net("UART_RX")),
            "PIO1": Net("LED"),
            "PIO0": Net("KEY_PIO0"),
        },
    },
    checks=[terminal_functions, identity],
)
