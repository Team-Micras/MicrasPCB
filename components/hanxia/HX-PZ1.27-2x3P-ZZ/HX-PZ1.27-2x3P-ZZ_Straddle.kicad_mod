(footprint "HX-PZ1.27-2x3P-ZZ_Straddle"
	(version 20260206)
	(generator "micras")
	(layer "F.Cu")
	(descr "Hanxia HX PZ1.27-2x3P ZZ 2x03 1.27 mm straight pin header straddling the bottom edge of a 0.8 mm board: its two rows clamp the board (0.87 mm between the 0.40 mm pins at 1.27 mm), the 2.30 mm pins soldered to 0.70 x 2.60 mm SMD pads, odd pins on the front (F.Cu), even on the back (B.Cu), 0.2 mm above the edge to 0.3 mm past the longest pin; the insulator (3.81 x 3.40 x 1.00 mm) below the edge, which rests on it; the 3.90 mm pins point down. Origin on the board's bottom edge, between the rows")
	(tags "connector pin header 2x03 1.27mm straight straddle edge mount")
