(footprint "WallSensor_SFH4550_TPS601A_THT"
	(version 20260206)
	(generator "micras")
	(generator_version "10.0")
	(descr "Micras wall sensor: SFH 4550 IR LED (pads 1-2) stacked over a TPS601A phototransistor (pads 3-4), leads bent 90 degrees, 2.54 mm pitch, 0.65 mm drill, hand-soldered. Bare devices, no casing: bodies from the SFH 4550 (v1.9 p.10) and TPS601A(F) (p.1) outlines, pads from the Altium MicrasLib WallSensor.")
	(tags "IR LED phototransistor THT micras wall sensor")
	(layer "F.Cu")
	(attr through_hole exclude_from_pos_files exclude_from_bom)
	(duplicate_pad_numbers_are_jumpers no)
