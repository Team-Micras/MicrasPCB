# Build outputs (CI publishes them; regenerate with `make all`)
build/

# Claude Code agent worktrees
.claude/worktrees/

# Toolchain and Python caches
.pcb/
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/

# KiCad local state and backups
*.kicad_prl
*-backups/
*.lck
_autosave-*
fp-info-cache
**/.history/
*.kicad_pcb-bak
*.kicad_sch-bak

# Zener layout sync byproducts (regenerated by `pcb apply`)
boards/*/layout/layout.log
boards/*/layout/default.net
boards/*/layout/fp-lib-table
boards/*/layout/snapshot.layout.json

# Autorouter exchange files
*.dsn
*.ses
