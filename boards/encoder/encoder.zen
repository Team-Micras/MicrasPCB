"""Micras encoder board.

One per wheel. The board stands upright in a slot in the main board, with the
AS5047U facing the diametric magnet on the wheel axle. Supply, SPI and the ABI
quadrature outputs leave through the edge tab soldered to the main board.

The circuit, designators, net names and layout are those of the Altium
MicrasEncoder project (hw_debug/modules/encoder, snapshot in
previous/board.json; `micras-pcb previous compare encoder` checks them).
Mechanical checks: spec/encoder.toml (outline, tab, sensor position).
"""

load("@stdlib/interfaces.zen", "Spi")
load(
    "@stdlib/board_config.zen",
    "BoardConfig",
    "Constraints",
    "Copper",
    "CopperLayer",
    "DesignRules",
    "DielectricLayer",
    "Material",
    "NetClass",
    "SolderMask",
    "Stackup",
)

AS5047U = Module("github.com/Team-Micras/MicrasPCB/components/ams/AS5047U/AS5047U.zen")
EncoderTab = Module("github.com/Team-Micras/MicrasPCB/components/micras/EncoderTab/EncoderTab.zen")
Capacitor = Module("@stdlib/generics/Capacitor.zen")

V3V3 = Power("3V3", voltage="3.3V")
GND = Ground("GND")
SPI = Spi(CS=Net("Encoder_CSn"), CLK=Net("SPI_SCK"), MISO=Net("SPI_MISO"), MOSI=Net("SPI_MOSI"))
ENCODER_ABI_A = Net("Encoder_ABI_A")
ENCODER_ABI_B = Net("Encoder_ABI_B")

AS5047U(name="IC1", VDD=V3V3, GND=GND, SPI=SPI, A=ENCODER_ABI_A, B=ENCODER_ABI_B)

# AS5047U DS v1-00 Figure 11, 3.3 V operation: 100 nF on the tied VDD/VDD3V3. Yageo
# CC0603KRX7R9BB104 (LCSC C14663, JLCPCB basic): 100 nF 10 % 50 V X7R 0603, as the Fenghua
# 0603B104K500NT the Altium schematic names (LCSC C30926, extended).
Capacitor(
    name="C1",
    value="100nF 10%",
    package="0603",
    voltage="50V",
    dielectric="X7R",
    mpn="CC0603KRX7R9BB104",
    manufacturer="Yageo",
    P1=V3V3,
    P2=GND,
)

EncoderTab(name="J1", VDD=V3V3, GND=GND, SPI=SPI, A=ENCODER_ABI_A, B=ENCODER_ABI_B)

# Stackup of MicrasEncoder.PcbDoc: 0.70 mm FR-4 core (Dk 4.5), 35 um copper. Zener writes a 10 um
# solder mask a side (not configurable): 0.79 mm (spec/encoder.toml, pcb.thickness); Altium's
# 0.5 mil (12.7 um) resist makes it 0.7954 mm. Ordered as JLCPCB's 0.8 mm 2-layer board.
# Solder mask expansion 0.02 mm (rule SolderMaskExpansion, 0.7874 mil).
# Vias 0.3 mm drill / 0.6 mm pad, the previous layout's (JLCPCB's no-surcharge drill).
Board(
    name="encoder",
    path="layout",
    layers=2,
    schematic=True,
    config=BoardConfig(
        design_rules=DesignRules(
            constraints=Constraints(
                copper=Copper(copper_to_edge_clearance=0.2),
                solder_mask=SolderMask(clearance=0.02),
            ),
            netclasses=[
                NetClass(
                    name="Default",
                    clearance=0.15,
                    track_width=0.254,
                    via_diameter=0.6,
                    via_drill=0.3,
                ),
            ],
        ),
        stackup=Stackup(
            materials=[Material(name="FR-4", relative_permittivity=4.5)],
            thickness=0.79,
            layers=[
                CopperLayer(thickness=0.035, role="mixed"),
                DielectricLayer(thickness=0.70, material="FR-4", form="core"),
                CopperLayer(thickness=0.035, role="mixed"),
            ],
        ),
    ),
)
