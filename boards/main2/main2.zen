# Stackup and rules: boards/main's, from the Altium MicrasMainBoard.PcbDoc (layer stack and design rules):
# 4 layers, 1 oz outer / 0.5 oz inner copper, 0.2104 mm prepreg (Dk 4.4) and 0.5 mm core
# (Dk 4.48), 1.0212 mm without mask. Zener writes a 10 um solder mask a side (not configurable),
# so the stackup totals 1.0412 mm; Altium's 0.6 mil (15.24 um) resist makes it 1.0517 mm. The
# board is ordered as JLCPCB's 1.0 mm 4-layer stackup either way. Rules: 0.1 mm clearance,
# 10 mil (0.254 mm) preferred track, 0.45 / 0.3 mm vias, 0.2 mm copper to board edge, 0.02 mm
# solder mask expansion (rule SolderMaskExpansion, 0.7874 mil). The track widths and the other
# via sizes are the ones its routing uses; the 0.35 / 0.2 mm via is main2's own, for the escapes
# of the STM32's 0.4 mm pitch pins (owner, 2026-10-18; JLCPCB's limits, rules/jlcpcb.kicad_dru:
# 0.15 mm hole, 0.05 mm ring, 0.075 mm preferred). Finish: ENIG, black solder mask, white
# silkscreen (the owner's choice).
Board(
    name="main2",
    path="layout",
    layers=4,
    schematic=True,
    config=BoardConfig(
        design_rules=DesignRules(
            constraints=Constraints(
                copper=Copper(
                    minimum_clearance=0.1,
                    minimum_track_width=0.1,
                    minimum_via_diameter=0.35,
                    copper_to_edge_clearance=0.2,
                ),
                holes=Holes(minimum_through_hole=0.2, hole_to_hole_clearance=0.254),
                # Silkscreen text down to 0.5 mm high with a 0.125 mm stroke, the owner's choice for
                # the reference designators. JLCPCB guarantees legibility from 1.0 mm high and
                # 0.153 mm stroke; this board accepts smaller text. The stroke minimum is set by
                # `micras-pcb rules` (rules/kicad-severities.toml [design.main2]): Zener has no field
                # for it.
                silkscreen=Silkscreen(minimum_text_height=0.5),
                solder_mask=SolderMask(clearance=0.02),
            ),
            predefined_sizes=PredefinedSizes(
                track_widths=[0.2, 0.2248, 0.254, 0.3, 0.4, 0.6, 0.8, 1.0],
                via_dimensions=[
                    ViaDimension(diameter=0.35, drill=0.2),
                    ViaDimension(diameter=0.45, drill=0.3),
                    ViaDimension(diameter=0.5, drill=0.3),
                    ViaDimension(diameter=0.8, drill=0.4),
                ],
            ),
            netclasses=[
                NetClass(
                    name="Default",
                    clearance=0.1,
                    track_width=0.254,
                    via_diameter=0.45,
                    via_drill=0.3,
                    diff_pair_width=0.2248,
                    diff_pair_gap=0.127,
                ),
            ],
        ),
        stackup=Stackup(
            copper_finish="ENIG",
            solder_mask_color="Black",
            silk_screen_color="White",
            materials=[
                Material(name="NP-155F prepreg", relative_permittivity=4.4),
                Material(name="NP-155F core", relative_permittivity=4.48),
            ],
            thickness=1.0412,
            layers=[
                CopperLayer(thickness=0.035, role="mixed"),
                DielectricLayer(thickness=0.2104, material="NP-155F prepreg", form="prepreg"),
                CopperLayer(thickness=0.0152, role="mixed"),
                DielectricLayer(thickness=0.5, material="NP-155F core", form="core"),
                CopperLayer(thickness=0.0152, role="mixed"),
                DielectricLayer(thickness=0.2104, material="NP-155F prepreg", form="prepreg"),
                CopperLayer(thickness=0.035, role="mixed"),
            ],
        ),
    ),
)
