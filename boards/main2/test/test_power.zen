"""Power stage: battery fuse F1 and switch Q6, the VSYS diode D14, the 3V3_D buck IC7, the 3V3_A
LDO U8, the battery divider, capacitor ratings.

Sources: ST DS13554 Rev 3 (L6981), ADI ADP7142 Rev K, Littelfuse 501 Series (Revised 12/14/17) and
Littelfuse "Fuseholder Rerating" (Chart II, pulse cycle withstand), JCET B5817W-B5819W, Huashuo
HSBB3072 Ver 3.0, ST DS14341 Rev 1 (STSPIN958 dVS/dt), ST DS13311 Rev 5, TI SLVSF66A (DRV8874),
Espressif ESP-Prog user guide (Program Interface), USB 2.0 Table 7-7 (VBUS), NASA GSFC
PD-ED-1201 Table 1 (capacitor derating), Samsung's DC-bias curves (passives.zen DC_BIAS), small
LiPo cell resistances (Takeyuta Lab, neophile.hatenablog.com/entry/2023/08/19/143147),
research/next-revision (Power tree; A.3, A.4) and its calculations/power_tree/vbat_bulk.py. Net
voltage ranges are main2.zen's (4S pack 12.0-17.4 V).
"""

load(
    "./helpers.zen",
    "all_two_terminal",
    "eng",
    "farads",
    "index",
    "net",
    "ohms",
    "refs_on",
    "report",
    "total",
    "two_terminal",
)
load("../passives.zen", "DC_BIAS")

MAIN2 = Module("../main2.zen")

BUCK = "IC7"
LDO = "U8"
FUSE = "F1"
MCU = "IC1"

# VBAT while D15 clamps: the pack pulled under braking, or a bench supply hot-plugged on long leads,
# at D15's 22.1 V VBR maximum (Regulators.zen; research calculations/power_tree/vbat_bulk.py
# sections 4 and 7).
VBAT_CLAMP = 24.2


def effective_farads(b, ref, volts):
    """Capacitance of `ref` at a DC bias, from passives.zen DC_BIAS (the fraction at the lowest
    tabulated voltage at or above `volts`); 0 F for a part with no curve in hand, or above it."""
    c = b.parts[ref]
    points = DC_BIAS.get(str(c.mpn), [])
    for v, fraction in points:
        if v >= volts - 1e-9:
            return farads(b, ref) * fraction
    return 0.0


def buck_output_capacitance(module, inputs):
    # DS13554 section 8.4.3 p28: the internal compensation is stable for COUT between Eq. 42,
    # 4.02 / ((fSW / 10) x VOUT), and Eq. 43, 0.48e-3 / VOUT; fSW 400 kHz (Table 6). The upper
    # bound takes every capacitor on the output net, the DNP options too, at its nominal value plus
    # 20 % (the widest tolerance there); the lower bound takes the fitted ones at their effective
    # capacitance at 3V3_D's maximum (DC_BIAS, Samsung curves; a part with no curve counts 0 F),
    # less 20 % tolerance and 15 % for temperature (Samsung TCC within -12 % over -40 to 85 C).
    b = index(module)
    out = net(b, BUCK, "VOUT/FB")
    lo, hi = 4.02 / (40e3 * 3.3), 0.48e-3 / 3.3
    vmax = b.parts[BUCK].pins["VOUT/FB"].voltage.max
    fitted = total([effective_farads(b, r, vmax) for r in two_terminal(b, "capacitor", out, "GND")]) * 0.8 * 0.85
    options = total([farads(b, r) for r in all_two_terminal(b, "capacitor", out, "GND")]) * 1.2
    p = []
    if options > hi:
        p.append(
            out + " carries up to " + eng(options, "F") + " with its DNP options, above " + eng(hi, "F") + " (Eq. 43)"
        )
    if fitted < lo:
        p.append(out + " keeps " + eng(fitted, "F") + " effective, below " + eng(lo, "F") + " (Eq. 42)")
    report(p)


def buck_inductor_current(module, inputs):
    # DS13554 Eq. 36: dIL = (VIN - VOUT) / L x D / fSW with D = VOUT / VIN; section 8.4.2: ripple
    # at most 40 % of IOUT (1.5 A); Eq. 39: IOUT + dIL / 2 below the 2.0 A minimum peak current
    # limit (Table 6). Worst case at the highest VSYS (the HV pack).
    b = index(module)
    sw, out = net(b, BUCK, "SW"), net(b, BUCK, "VOUT/FB")
    coils = two_terminal(b, "inductor", sw, out)
    if len(coils) != 1:
        report(["expected one inductor from SW (" + sw + ") to " + out + ", found " + str(coils)])
        return
    l = b.parts[coils[0]].inductance.value
    vin = b.parts[BUCK].pins["VIN"].voltage.max
    ripple = (vin - 3.3) / l * (3.3 / vin) / 400e3
    p = []
    if ripple > 0.4 * 1.5:
        p.append(coils[0] + " ripple " + eng(ripple, "A") + " at VIN " + eng(vin, "V") + " is above 40 % of 1.5 A")
    if 1.5 + ripple / 2 > 2.0:
        p.append("IC7 peak inductor current " + eng(1.5 + ripple / 2, "A") + " reaches the 2.0 A current limit")
    report(p)


def buck_input_capacitance(module, inputs):
    # DS13554 Eq. 35: CIN,min = IOUT / (4 x VPP,max x fSW) at the D = 0.5 worst case, with VPP
    # "in the order of 5 % VINMAX" (section 8.4.1); IOUT 1.5 A, fSW 360 kHz minimum (Table 6).
    # The capacitance is the effective one at VSYS's maximum (DC_BIAS), less 10 % tolerance.
    b = index(module)
    vin = net(b, BUCK, "VIN")
    vmax = b.parts[BUCK].pins["VIN"].voltage.max
    need = 1.5 / (4 * 0.05 * vmax * 360e3)
    ceff = total([effective_farads(b, r, vmax) for r in two_terminal(b, "capacitor", vin, "GND")]) * 0.9
    report(
        []
        if ceff >= need
        else [BUCK + " CIN keeps " + eng(ceff, "F") + " at " + eng(vmax, "V") + ", Eq. 35 asks " + eng(need, "F")]
    )


def buck_slope_compensation(module, inputs):
    # DS13554 section 7.1: QP = 1 / (pi x (mC x (1 - D) - 0.5)) (Eq. 13), mC = 1 + Se / Sn,
    # Se = ISLOPE x fSW with ISLOPE = 1 A (Eq. 11), Sn = (VIN - VOUT) / L; Eq. 38 asks
    # 0.4 <= QP <= 1.33. Taken literally this gives QP 0.33-0.39 for L3 22 uH over the 12-17.4 V
    # pack, below 0.4; the datasheet's own Table 2 design (33 uH) gives
    # lower still (0.30 at 17.4 V, 0.28 at 12 V), and its "full slope contribution" peak current
    # limit (1.55 A against 2.0 A, Table 6) implies a ramp of about 0.45 A, not 1 A, and ST's own
    # 3.3 V curves (section 10, Fig. 40-45) use 22 uH. So the lower bound is not applied as
    # written. The current loop is sub-harmonically stable for any ISLOPE above
    # (Sf - Sn) / (2 x fSW) = (2 VOUT - VIN) / (2 L fSW): at VSYS's 3.8 V minimum (on 5V_IN) and
    # fSW's 360 kHz minimum (Table 6), 0.177 A for 22 uH and 0.22 A with L3 at -20 % (research
    # calculations/power_tree/l6981_slope.py). What is checked: QP never exceeds 1.33 (no
    # sub-harmonic oscillation, the bound that a small inductor breaks); L3 is no larger than
    # Table 2's 33 uH, so its QP is never below the datasheet's typical application at the same
    # input; and that ISLOPE threshold, at L3's -20 %, stays below the smaller reading of the
    # datasheet's ramp, about 0.45 A (Table 6's "full slope contribution" current limit, 1.55 A
    # against 2.0 A).
    b = index(module)
    sw, out = net(b, BUCK, "SW"), net(b, BUCK, "VOUT/FB")
    coils = two_terminal(b, "inductor", sw, out)
    if len(coils) != 1:
        report(["expected one inductor from SW to " + out])
        return
    l = b.parts[coils[0]].inductance.value
    vin = b.parts[BUCK].pins["VIN"].voltage
    p = []
    for fsw in [360e3, 440e3]:
        for v in [vin.min, 12.0, vin.max]:
            d = 3.3 / v
            mc = 1 + 1.0 * fsw / ((v - 3.3) / l)
            x = mc * (1 - d) - 0.5
            qp = 1 / (3.14159265 * x) if x > 0 else 1e9
            if qp > 1.33:
                p.append(coils[0] + " QP " + str(qp) + " at " + eng(v, "V") + " above 1.33 (Eq. 38)")
    if l > 33e-6 * 1.001:
        p.append(coils[0] + " " + eng(l, "H") + " above Table 2's 33 uH")
    need = (2 * 3.346 - vin.min) / (2 * l * 0.8 * 360e3)
    if need >= 0.45:
        p.append(
            coils[0] + " needs ISLOPE above " + eng(need, "A") + " at " + eng(vin.min, "V") + ", 360 kHz and L -20 %"
        )
    report(p)


def vsys_blocks_back_feed(module, inputs):
    # Research Power tree and A.4: VSYS is VBAT through a 40 V Schottky (D14, anode on the bridges'
    # VBAT) or 5V_IN through another (D17), and only the two regulators and their input parts load
    # it. 5V_IN is a programmer's 5 V pin: J2 pin 2 (the ESP-Prog Program Interface's VDD) and SWD1
    # pad 4. D14 keeps it off VBAT and the pack; D17 keeps the pack off the programmer. No connector
    # pin reaches 3V3_D: a programmer's 3.3 V never meets the buck's output.
    b = index(module)
    p = []
    vbat, vsys = net(b, "D14", "A"), net(b, "D14", "K")
    if vbat != net(b, "IC8", "VM"):
        p.append("D14's anode is not on the bridges' VBAT")
    for d in ["D14", "D17"]:
        if "B5819" not in str(b.parts[d].mpn):
            p.append(d + " must be a B5819W Schottky into VSYS")
    if net(b, "D17", "K") != vsys:
        p.append("D17's cathode is not on VSYS")
    v5 = net(b, "D17", "A")
    if v5 != "5V_IN":
        p.append("D17's anode must be 5V_IN, is " + v5)
    if net(b, BUCK, "VIN") != vsys:
        p.append(BUCK + " VIN is not on " + vsys)
    loads = sorted([r for r in refs_on(b, vsys) if b.parts[r].type not in ["capacitor", "resistor"]])
    if loads != sorted(["D14", "D17", BUCK]):
        p.append(vsys + " loads: " + str(loads) + "; only D14, D17 and IC7 (and U8 through its input resistor)")
    if net(b, "J2", "Pin_2") != v5:
        p.append("J2 pin 2 (the programmer's VDD) is not on 5V_IN")
    if net(b, "SWD", "VDD") != v5:
        p.append("SWD1 pad 4 (the probe's 5 V) is not on 5V_IN")
    on_v5 = sorted(refs_on(b, v5))
    if on_v5 != sorted(["D17", "J2", "SWD"]):
        p.append("5V_IN reaches " + str(on_v5) + "; only J2, SWD1 and D17 belong there")
    v33 = net(b, BUCK, "VOUT/FB")
    connectors = [r for r in refs_on(b, v33) if r.startswith("J") or r.startswith("SWD")]
    if connectors:
        p.append("3V3_D reaches a connector pin: " + str(connectors))
    # D17 is reversed by VSYS with the pack in, up to the D15 clamp less D14's drop with 5V_IN open:
    # within the B5819W's VRRM 40 V (JCET B5817W-B5819W p1)
    if VBAT_CLAMP >= 40:
        p.append("D17: the " + eng(VBAT_CLAMP, "V") + " clamp reaches the B5819W's 40 V VRRM")
    report(p)


# 5V_IN programming power (research calculations/power_tree/power_path_checks.py section 2): the
# 3V3_D load while flashing, 0.273 A at most (the MCU running, the ESP32-C5's Wi-Fi in RX;
# calc_power_tree.py section 6).
FLASHING_LOAD = 0.273


def programming_power_regulates(module, inputs):
    # The buck runs from VSYS's lowest point on 5V_IN (5V_IN's minimum less D17's 0.6 V maximum):
    # inside DS13554's 3.5 V minimum (Table 6), and at the flashing load its duty (Eq. 45, RDSON
    # 0.175 / 0.125 Ohm typ + 20 % for temperature, section 9; L3's DCR; VOUT 3.346 V max) stays under
    # 1 - TOFF_MIN x fSW (185 ns typ, 440 kHz max: Table 6).
    b = index(module)
    vsys = b.parts[BUCK].pins["VIN"].voltage.min
    v5 = b.parts["D17"].pins["A"].voltage.min
    p = []
    if vsys > v5 - 0.6 + 1e-6:
        p.append("VSYS is declared from " + eng(vsys, "V") + ", above 5V_IN's " + eng(v5, "V") + " less D17's 0.6 V")
    if vsys < 3.5:
        p.append("VSYS reaches " + eng(vsys, "V") + ", below the L6981's 3.5 V minimum")
    dcr = 0.130  # L3 YSPIA0645-220M, 130 mOhm max (components/yjycoin/YSPIA0645-220M)
    dmax = 1 - 185e-9 * 440e3
    i = FLASHING_LOAD
    need = (3.346 + (0.125 * 1.2 + dcr) * i) / dmax + (0.175 - 0.125) * 1.2 * i
    if vsys < need:
        p.append(BUCK + " needs " + eng(need, "V") + " at " + eng(i, "A") + ", VSYS falls to " + eng(vsys, "V"))
    report(p)


def plug_in_keeps_q6_off(module, inputs):
    # At plug-in the pack's edge lands on Q6's drain (the board's GND, held to VBAT by the bulk)
    # and couples to its gate through the gate-drain capacitance; the gate-source capacitance holds
    # it down. Q6 must stay below VGS(th) min, 1.0 V at 25 C (HSBB3072 p2), so that it turns on only
    # through SW4, slewed (STSPIN958 dVS/dt 0.5 V/us, DS14341 Table 1). Worst case: the drain rings
    # up to the D15 clamp (24.2 V), the external gate-drain capacitors at +tolerance, the
    # gate-source ones at -tolerance. Q6's own Crss is nonlinear: the charge it passes from 0 to
    # 24.2 V is 10.7 nC (Fig. 7, integrated: 1600 pF at 0 V to 125 pF at 25 V); Cgs is Ciss - Crss,
    # 2.63 nF (p2: 2860 - 229 pF at 15 V). Also at the hottest board, VGS(th) falls to 0.75 x
    # (Fig. 5 at 85 C): the 17.4 V pack must stay below 0.75 V there.
    b = index(module)
    gate, drain, source = net(b, "Q6", "G"), net(b, "Q6", "D"), net(b, "Q6", "S")
    cgd = [r for r in two_terminal(b, "capacitor", gate, drain)]
    cgs = [r for r in two_terminal(b, "capacitor", gate, source)]

    cgd_max = total([farads(b, r) * (1 + 0.1) for r in cgd])
    cgs_min = total([farads(b, r) * (1 - 0.1) for r in cgs])
    p = []
    for v, qrss, vth, case in [
        (VBAT_CLAMP, 10.7e-9, 1.0, "the 24.2 V clamp at 25 C"),
        (17.4, 9.7e-9, 0.75, "the 17.4 V pack at 85 C"),
    ]:
        vg = (cgd_max * v + qrss) / (cgs_min + 2.63e-9 + cgd_max + 0.13e-9)
        if vg >= vth:
            p.append("Q6's gate reaches " + eng(vg, "V") + " at " + case + ", above VGS(th) min " + eng(vth, "V"))
    if not cgs:
        p.append("Q6 has no gate-source capacitor")
    report(p)


def analog_ldo(module, inputs):
    # ADP7142 Rev H: VIN from VSYS through 22 Ohm + 10 uF (research A.4); input and output
    # capacitors >= 2.2 uF, the input at least the output (Table 2, Capacitor Selection); EN on
    # 3V3_D so 3V3_A starts after VDD (DS13311 section 3.7.1); SS open; the output feeds VDDA.
    b = index(module)
    p = []
    vin, vout = net(b, LDO, "VIN"), net(b, LDO, "VOUT")
    rin = two_terminal(b, "resistor", vin, "VSYS")
    if len(rin) != 1 or abs(ohms(b, rin[0]) - 22) > 2.2:
        p.append(LDO + " VIN must come from VSYS through 22 Ohm, found " + str(rin))
    # The output capacitor is the bulk at the LDO (1 uF or more); the 100 nF on 3V3_A decouple
    # its loads.
    cin = total([farads(b, r) for r in two_terminal(b, "capacitor", vin, "GND")])
    cout = total([farads(b, r) for r in two_terminal(b, "capacitor", vout, "GND") if farads(b, r) >= 1e-6])
    if cin < 2.2e-6 or cout < 2.2e-6:
        p.append(LDO + " needs >= 2.2 uF on VIN and VOUT (Table 2): " + eng(cin, "F") + " / " + eng(cout, "F"))
    if cin < cout * 0.99:
        p.append(LDO + " input capacitance " + eng(cin, "F") + " below the output's " + eng(cout, "F"))
    # Eq. 4: CEFF = CBIAS x (1 - TEMPCO) x (1 - TOL) >= 1.5 uF, TEMPCO 15 % (X5R/X7R), TOL 10 %,
    # CBIAS at the highest input voltage (DC_BIAS; a part with no curve counts 0 F).
    vmax = b.parts[LDO].pins["VIN"].voltage.max
    ceff = total([effective_farads(b, r, vmax) for r in two_terminal(b, "capacitor", vin, "GND")]) * 0.85 * 0.9
    if ceff < 1.5e-6:
        p.append(LDO + " input keeps " + eng(ceff, "F") + " effective at " + eng(vmax, "V") + ", below 1.5 uF (Eq. 4)")
    # The output the same way at 3V3_A's maximum, with 20 % tolerance (C81 is an M part).
    vout_max = b.parts[LDO].pins["VOUT"].voltage.max
    coeff = total([effective_farads(b, r, vout_max) for r in two_terminal(b, "capacitor", vout, "GND")])
    if coeff * 0.85 * 0.8 < 1.5e-6:
        p.append(LDO + " output keeps " + eng(coeff * 0.85 * 0.8, "F") + " effective, below 1.5 uF (Table 2)")
    if net(b, LDO, "EN") != net(b, MCU, "VDD"):
        p.append(LDO + " EN must be on the MCU's VDD (3V3_D) so VDDA follows VDD")
    ss = b.parts[LDO].pins["SS"]
    # a no-connect pin has an empty net name
    if ss.name != "" and (ss.name == "GND" or [r for r in refs_on(b, ss.name) if r != LDO]):
        p.append(LDO + " SS must be open (never grounded; pin table)")
    if not two_terminal(b, "resistor", vout, net(b, MCU, "VDDA")):
        p.append("VDDA is not fed from " + vout)
    report(p)


def analog_ldo_dissipation(module, inputs):
    # ADP7142 Rev K Eq. 10: PD = (VIN - VOUT) x ILOAD + VIN x IGND, IGND 190 uA max at 10 mA
    # (Table 1), with the research's 22.5 mA worst-case 3V3_A load; TJ = TA + PD x RthJA must stay
    # at or below 125 C (p17) at an 85 C ambient. RthJA 83.9 C/W: Table 6's 500 mm2 copper row, less
    # than the exposed pad has on the layout (the F.Cu GND pour and two vias to the In1/In2 GND
    # planes; Table 4's JEDEC 4-layer board gives 72.1 C/W).
    b = index(module)
    vin = b.parts[LDO].pins["VIN"].voltage.max
    pd = (vin - 3.24) * 22.5e-3 + vin * 190e-6
    tj = 85 + pd * 83.9
    report([] if tj <= 125 else [LDO + " reaches TJ " + eng(tj, "C") + " (" + eng(pd, "W") + ") at 85 C ambient"])


# PC5 is a TT_ha pin: 4.0 V absolute maximum, no positive injection (DS13311 Rev 5 Tables 10-11);
# VDDA (= VREF+) is at least 3.24 V (3V3_A, ADP7142 Table 1).
PC5_ABS_MAX = 4.0
VDDA_MIN = 3.24


def battery_divider(module, inputs):
    # The pack's top (17.4 V HV) divided onto PC5 stays below VDDA, and D15's 24.2 V clamp below
    # PC5's 4.0 V absolute maximum with 1 % parts; the firmware constant is the ratio
    # (boards/main2/firmware_changes.toml battery: 11.0).
    b = index(module)
    tap = net(b, MCU, "PC5")
    up = [
        r
        for r in refs_on(b, tap)
        if b.parts[r].type == "resistor" and net(b, r, "1") != "GND" and net(b, r, "2") != "GND"
    ]
    down = two_terminal(b, "resistor", tap, "GND")
    if len(up) != 1 or len(down) != 1:
        report(["PC5: expected one resistor from VBAT and one to GND"])
        return
    ru, rd = ohms(b, up[0]), ohms(b, down[0])
    ratio = (ru + rd) / rd
    ratio_min = (ru * 0.99 + rd * 1.01) / (rd * 1.01)
    p = []
    if 17.4 / ratio > VDDA_MIN:
        p.append("the 17.4 V pack gives " + eng(17.4 / ratio, "V") + " on PC5, above VDDA")
    if VBAT_CLAMP / ratio_min > PC5_ABS_MAX:
        p.append("the 24.2 V clamp gives " + eng(VBAT_CLAMP / ratio_min, "V") + " on PC5, above its 4.0 V maximum")
    if abs(ratio - 11.0) > 0.01:
        p.append("divider ratio " + str(ratio) + ", the firmware constant is 11.0")
    report(p)


# Battery current budgets (research/next-revision Drivetrain and Power tree): 3-4 A rms on the
# battery path; the summed peak limits, both bridges at their 2.97 A ITRIP and the fan at its
# 3.94 A limit (Drivers.zen) with about 0.2 A for the 3V3 rails, 10.1 A, held during stall bursts.
# The largest pulse F1 sees at plug-in or SW4 turning on: 5.7 mA2s (vbat_bulk.py section 8, the
# board's gate network, a 24 V bench supply on 1 m leads; 4.0 mA2s from a pack); 0.01 A2s here.
BATTERY_RMS = 4.0
BATTERY_PEAK = 10.1
PLUG_IN_I2T = 0.01
# The pack's short-circuit current: series cells carry one current, so a 4S pack shorts at
# VCELL / RCELL, 4.35 V (a full HV cell) over the lowest ohmic resistance published for cells of
# its class, 52.8 mOhm (a 1S 180 mAh cell; Takeyuta Lab, AC meter), before the leads, J1 and F1.
PACK_SHORT = 4.35 / 52.8e-3


def battery_fuse(module, inputs):
    # F1 carries the whole battery current from J1 to VBAT, and nothing else sits ahead of it.
    # Littelfuse 501 (notes, Temperature Re-rating Curve): continuously 80 % of the rating times
    # 0.85 at 75 C covers the rms budget; at 100 % of the rating (4 h minimum) times 0.85 it holds
    # the summed peak limits even if they lasted. Average Time Current Curves: a stall burst of the
    # summed peak opens nothing (the 100 s opening current, times 0.85 at 75 C, is far above it),
    # and as a repeated pulse its (I / I_open)^2 stays within 22 % (Littelfuse Fuseholder Rerating,
    # Chart II: 100,000 pulses at 22 % of the melting I2t). The plug-in pulse stays within 22 % of
    # the melting I2t. The interrupting rating holds up to the 32 V rating, above the pack.
    b = index(module)
    p = []
    f = b.parts[FUSE]
    if net(b, FUSE, "1") != net(b, "J1", "Pin_1") or net(b, FUSE, "2") != net(b, "IC8", "VM"):
        p.append(FUSE + " must carry the battery current from J1 to VBAT")
    ahead = sorted([r for r in refs_on(b, net(b, "J1", "Pin_1")) if r not in ["J1", FUSE]])
    if ahead:
        p.append("ahead of " + FUSE + " on the pack's +: " + str(ahead))
    rating = f.properties["current_rating"].value
    hot = rating * f.properties["continuous_derating"] * 0.85
    if hot < BATTERY_RMS:
        p.append(
            FUSE
            + " carries "
            + eng(hot, "A")
            + " continuously at 75 C, below the "
            + eng(BATTERY_RMS, "A")
            + " rms budget"
        )
    if rating * 0.85 < BATTERY_PEAK:
        p.append(
            FUSE
            + " holds "
            + eng(rating * 0.85, "A")
            + " at 75 C, below the "
            + eng(BATTERY_PEAK, "A")
            + " summed peak limits"
        )
    i_open = f.properties["opening_current_100s"] * 0.85
    if (BATTERY_PEAK / i_open) * (BATTERY_PEAK / i_open) > 0.22:
        p.append(FUSE + ": a " + eng(BATTERY_PEAK, "A") + " burst is above 22 % of the 100 s melting I2t at 75 C")
    if PLUG_IN_I2T > 0.22 * f.properties["melting_i2t"]:
        p.append(
            FUSE
            + " melting I2t "
            + str(f.properties["melting_i2t"])
            + " A2s against a "
            + str(PLUG_IN_I2T)
            + " A2s plug-in pulse"
        )
    if PACK_SHORT > f.properties["interrupting_current"].value:
        p.append(
            FUSE
            + " interrupts "
            + eng(f.properties["interrupting_current"].value, "A")
            + "; the pack can short at "
            + eng(PACK_SHORT, "A")
        )
    pack = f.pins["1"].voltage.max
    if pack > f.properties["voltage_rating"].value:
        p.append(
            FUSE
            + " is rated "
            + eng(f.properties["voltage_rating"].value, "V")
            + "; the pack reaches "
            + eng(pack, "V")
        )
    report(p)


def battery_switch_slew(module, inputs):
    # STSPIN958 VS on VBAT: dVS/dt at most 0.5 V/us (DS14341 Table 1). Q6's drain slews at the
    # Miller plateau with IG / CGD: dV/dt <= VBAT / (RG x (Crss + external CGD)), Crss 229 pF
    # (HSBB3072 p2).
    b = index(module)
    gate, drive = net(b, "Q6", "G"), net(b, "SW4", "B")
    rg = two_terminal(b, "resistor", drive, gate)
    if len(rg) != 1:
        report(["Q6 gate: expected one series resistor from SW4 to " + gate + ", found " + str(rg)])
        return
    cgd = 229e-12 + total([farads(b, r) for r in two_terminal(b, "capacitor", gate, net(b, "Q6", "D"))])
    vbat = b.parts["SW4"].pins["COM"].voltage.max
    slew = vbat / (ohms(b, rg[0]) * cgd)
    report([] if slew <= 0.5e6 else ["Q6 turn-on slews VBAT at up to " + eng(slew / 1e6, "V/us") + ", above 0.5 V/us"])


def battery_switch_rating(module, inputs):
    # SW4 carries Q6's gate drive from VBAT: its DC rating must cover the pack (17.4 V with HV
    # cells; research Power tree, 4S ratings). SK-12D29-G060: DC 24 V (G-Switch specification).
    b = index(module)
    sw = b.parts["SW4"]
    vmax = sw.pins["COM"].voltage.max
    rated = sw.properties["voltage"].value
    report([] if rated >= vmax else ["SW4 is rated " + eng(rated, "V") + " DC, below the " + eng(vmax, "V") + " pack"])


def ceramic_capacitors_only(module, inputs):
    # The board as designed is all ceramic, a choice on merit (research Power tree, VBAT
    # capacitance; calculations/power_tree/vbat_bulk.py): the ceramics meet every VBAT job, and a
    # 35 V solid-polymer aluminium bulk would only trim margins that already hold, for a 6.3 mm
    # can. Liquid electrolytics stay out (the owner's rule; solid polymer would be allowed). Every
    # capacitor is a stdlib ceramic with a dielectric.
    b = index(module)
    p = []
    for ref, c in b.parts.items():
        if c.type == "capacitor" and not (hasattr(c, "dielectric") and c.dielectric != None):
            p.append(ref + " (" + str(c.mpn) + ") is not a ceramic capacitor")
    report(p)


def vbat_clamp(module, inputs):
    # VBAT needs a TVS that clamps below the DRV8874's 40 V VM absolute maximum (SLVSF66A 6.1)
    # with the pack pulled under braking, and stands off the 17.4 V pack. Its cathode sits on
    # VBAT, behind the fuse, its anode on GND or on GND_BAT (GND through Q6, whose body diode
    # conducts GND_BAT -> GND with Q6 off).
    b = index(module)
    vbat = net(b, "IC8", "VM")
    q6_source = net(b, "Q6", "S") if net(b, "Q6", "D") == "GND" else None
    found = []
    for ref, c in b.parts.items():
        if c.type != "tvs" or c.dnp or "K" not in c.pins or "A" not in c.pins:
            continue
        k, a = net(b, ref, "K"), net(b, ref, "A")
        if k != vbat or a not in ["GND", q6_source]:
            continue
        if "clamping_voltage" not in c.properties:
            continue
        vc = c.properties["clamping_voltage"].value
        vr = c.properties["reverse_standoff_voltage"].value
        pack = c.pins["K"].voltage.max
        if vc >= 40.0:
            report([ref + " clamps at " + eng(vc, "V") + ", not below the DRV8874's 40 V"])
            return
        if vr < pack:
            report([ref + " stands off " + eng(vr, "V") + ", below the " + eng(pack, "V") + " pack"])
            return
        found.append(ref)
    report([] if found else ["VBAT has no TVS from VBAT to GND/GND_BAT clamping below 40 V"])


def capacitor_voltage_ratings(module, inputs):
    # Every capacitor's rated voltage must cover the largest voltage across it, from the
    # declared ranges of the nets it joins (nets without a declared range are skipped).
    b = index(module)
    p = []
    for ref, c in b.parts.items():
        if c.type != "capacitor" or not hasattr(c, "voltage") or not c.voltage:
            continue
        vs = [n.voltage for n in c.pins.values()]
        if len(vs) != 2 or not vs[0] or not vs[1]:
            continue
        worst = max(abs(vs[0].max - vs[1].min), abs(vs[1].max - vs[0].min))
        if c.voltage.value < worst:
            p.append(ref + " rated " + eng(c.voltage.value, "V") + " sees up to " + eng(worst, "V"))
    report(p)


def capacitor_voltage_derating(module, inputs):
    # NASA GSFC PD-ED-1201 Table 1: a ceramic capacitor at most at 60 % of its rated voltage in
    # steady state, from the declared ranges of the nets it joins. Exceptions, each argued:
    # none today.
    b = index(module)
    p = []
    for ref, c in b.parts.items():
        if c.type != "capacitor" or not hasattr(c, "voltage") or not c.voltage:
            continue
        vs = [n.voltage for n in c.pins.values()]
        if len(vs) != 2 or not vs[0] or not vs[1]:
            continue
        worst = max(abs(vs[0].max - vs[1].min), abs(vs[1].max - vs[0].min))
        if worst > 0.6 * c.voltage.value + 1e-9:
            p.append(ref + " at " + eng(worst, "V") + " is above 60 % of its " + eng(c.voltage.value, "V"))
    report(p)


# Absolute maxima of the parts on VBAT and VSYS (their datasheets, as cited in each package):
# HSBB3072 VDS 30 V (p1); B5819W VRRM 40 V (p1); L6981 VIN 42 V (Table 3);
# ADP7142 VIN 44 V (Table 3); DRV8874 VM 40 V (6.1); STSPIN958 VS 62 V (Table 1); Littelfuse 501
# 32 V; SK-12D29-G060 withstands AC 250 V for 1 min (its DC 24 V is the rating for switching
# 1 A; it carries 87 uA and does not switch during a clamp).
ABS_MAX = {
    "HSBB3072": 30.0,
    "B5819W": 40.0,
    "L6981C33DR": 42.0,
    "ADP7142ACPZN3.3-R7": 44.0,
    "DRV8874PWPR": 40.0,
    "STSPIN958TR": 62.0,
    "0501012.WR1": 32.0,
    "SK-12D29-G060": 250.0,
}


def abs_max_under_clamp(module, inputs):
    # Every part on VBAT, VSYS or LDO_IN holds VBAT_CLAMP (24.2 V): capacitors by their rated
    # voltage, the semiconductors, the fuse and the switch by ABS_MAX. Resistors are 50 V and up.
    b = index(module)
    nets = [net(b, "IC8", "VM"), net(b, BUCK, "VIN"), net(b, LDO, "VIN")]
    p = []
    seen = []
    for n in nets:
        for ref in refs_on(b, n):
            c = b.parts[ref]
            # D15 is the clamp itself.
            if ref in seen or c.type in ["resistor", "tvs"] or c.dnp:
                continue
            seen.append(ref)
            if c.type == "capacitor":
                rated = c.voltage.value
            elif str(c.mpn) in ABS_MAX:
                rated = ABS_MAX[str(c.mpn)]
            else:
                p.append(ref + " (" + str(c.mpn) + ") has no absolute maximum listed for the clamp check")
                continue
            if rated < VBAT_CLAMP:
                p.append(ref + " rated " + eng(rated, "V") + " under the " + eng(VBAT_CLAMP, "V") + " clamp")
    report(p)


def regulator_outputs_are_ranges(module, inputs):
    # Each regulated rail is declared with its regulator's tolerance (min != max), so the build's
    # range check catches a part whose supply range it leaves: 3V3_D (DS13554 Table 6), 3V3_A and
    # VDDA (ADP7142 Rev H Table 1).
    b = index(module)
    p = []
    for ref, pin in [(BUCK, "VOUT/FB"), (LDO, "VOUT"), (MCU, "VDDA")]:
        v = b.parts[ref].pins[pin].voltage
        if not v or v.max - v.min < 1e-3:
            p.append(net(b, ref, pin) + " is declared at a single voltage")
    report(p)


TestBench(
    name="main2_power",
    module=MAIN2,
    test_cases={"board": {}},
    checks=[
        buck_output_capacitance,
        buck_inductor_current,
        buck_input_capacitance,
        buck_slope_compensation,
        vsys_blocks_back_feed,
        programming_power_regulates,
        plug_in_keeps_q6_off,
        analog_ldo,
        analog_ldo_dissipation,
        battery_divider,
        battery_fuse,
        battery_switch_slew,
        battery_switch_rating,
        ceramic_capacitors_only,
        vbat_clamp,
        capacitor_voltage_ratings,
        capacitor_voltage_derating,
        abs_max_under_clamp,
        regulator_outputs_are_ranges,
    ],
)
