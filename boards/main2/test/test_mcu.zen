"""STM32H725RGV6 (IC1) application circuit and its links to the ESP32-C5 (U13): supplies, boot
and reset, SWD, the SPI2/UART4 link, the IMU interrupt, the pin budget.

Sources: ST DS13311 Rev 5, AN5419 Rev 3, RM0468 Rev 3; Espressif ESP32-C5-MINI-1 datasheet v1.4
(Tables 3-1, 4-1), the ESP32-C5 Series Datasheet v1.5 (section 2.3.5) and Technical Reference
Manual v1.1 (Table 8.13-1); ST DS13476 Rev 5 (LSM6DSV); research/next-revision (H7 pin budget,
ESP32 radio, A.6).
"""

load(
    "./helpers.zen",
    "eng",
    "farads",
    "index",
    "net",
    "ohms",
    "other_net",
    "refs_on",
    "report",
    "series_to",
    "touching",
    "two_terminal",
)

MAIN2 = Module("../main2.zen")

MCU = "IC1"
ESP = "U13"
# The ESP32-C5's GPIOs free of any restriction (ESP32-C5 Series Datasheet v1.5 section 2.3.5,
# priority 2: no strapping, pad-JTAG, UART0, USB or flash role), each with its input and output
# off and no pull at reset (TRM v1.1 Table 8.13-1, Reset 0). Neither document lists a power-up
# glitch for any C5 pin. Every MCU link lands on one of them.
FREE = ["IO0", "IO1", "IO6", "IO8", "IO9", "IO10", "IO23", "IO24"]


def _caps_to_gnd(b, name, value):
    """Capacitors from net `name` to GND whose nominal value is `value` (farads, 10 % match)."""
    return [r for r in two_terminal(b, "capacitor", name, "GND") if abs(farads(b, r) - value) <= 0.1 * value]


def direct_smps_core_supply(module, inputs):
    # AN5419 Figure 5 p10 "Direct SMPS supply" and Table 2 p7-8: VFBSMPS and all VCAP pins on
    # one node, a 2.2 uH inductor from VLXSMPS to it, 2 x 10 uF on it and 100 nF at each VCAP.
    b = index(module)
    p = []
    core = net(b, MCU, "VFBSMPS")
    for pin in ["VCAP1", "VCAP2", "VCAP3"]:
        if net(b, MCU, pin) != core:
            p.append("IC1 " + pin + " is on " + net(b, MCU, pin) + ", not on the VFBSMPS node " + core)
    coils = two_terminal(b, "inductor", net(b, MCU, "VLXSMPS"), core)
    if len(coils) != 1 or abs(b.parts[coils[0]].inductance.value - 2.2e-6) > 0.05 * 2.2e-6:
        p.append("expected one 2.2 uH inductor from VLXSMPS to " + core + ", found " + str(coils))
    if len([r for r in two_terminal(b, "capacitor", core, "GND") if farads(b, r) >= 10e-6 * 0.99]) < 2:
        p.append(core + " needs 2 x 10 uF (AN5419 Table 2)")
    if len(_caps_to_gnd(b, core, 100e-9)) < 3:
        p.append(core + " needs 100 nF at each of the 3 VCAP pins")
    report(p)


def vdd_decoupling(module, inputs):
    # AN5419 Table 2 p7: 100 nF per VDD pin (five on VFQFPN68) and one 4.7 uF; VDDSMPS = VDD.
    b = index(module)
    p = []
    vdd = net(b, MCU, "VDD")
    if net(b, MCU, "VDDSMPS") != vdd:
        p.append("VDDSMPS must be on the VDD supply (DS13311 section 3.7.1)")
    if len(_caps_to_gnd(b, vdd, 100e-9)) < 5:
        p.append(vdd + " needs five 100 nF, one per VDD pin")
    if not [r for r in two_terminal(b, "capacitor", vdd, "GND") if farads(b, r) >= 4.7e-6 * 0.99]:
        p.append(vdd + " needs a 4.7 uF")
    report(p)


def vdda_from_the_analog_rail(module, inputs):
    # AN5419 Table 2 p7: VDDA 1 uF + 100 nF at the pin. Research Power tree: VDDA from 3V3_A (the
    # ADP7142 LDO) through a 0 Ohm link or a bead of 50 mOhm or less, never from 3V3_D; VREF+ is
    # VDDA on this package (DS13311 Figures 46-47 note 1).
    b = index(module)
    p = []
    vdda = net(b, MCU, "VDDA")
    if not (_caps_to_gnd(b, vdda, 1e-6) and _caps_to_gnd(b, vdda, 100e-9)):
        p.append(vdda + " needs 1 uF + 100 nF (AN5419 Table 2)")
    links = [r for r in touching(b, "resistor", vdda) if ohms(b, r) <= 0.05]
    source = [other_net(b, r, vdda) for r in links]
    if not source or net(b, "U8", "VOUT") not in source:
        p.append(vdda + " must come from U8 VOUT (3V3_A) through a 0-50 mOhm link, found " + str(source))
    if net(b, MCU, "VDD") in source:
        p.append(vdda + " is fed from VDD")
    report(p)


def vbat_on_vdd(module, inputs):
    # AN5419 Table 2 p7: VBAT to VDD when no backup battery is used.
    b = index(module)
    report([] if net(b, MCU, "VBAT") == net(b, MCU, "VDD") else ["IC1 VBAT must be on VDD"])


def boot0_pulled_down(module, inputs):
    # AN5419 Figure 19 p30: BOOT0 to VSS through 10 kOhm; no capacitor from BOOT0 to a supply
    # (its power-up ramp would boot the system bootloader, AN2606). Nothing else touches BOOT0:
    # the MCU always starts from its flash (boards/main2/firmware_changes.toml, flash).
    b = index(module)
    boot = net(b, MCU, "BOOT0")
    p = []
    downs = [r for r in two_terminal(b, "resistor", boot, "GND") if ohms(b, r) <= 10e3 * 1.01]
    if not downs:
        p.append("BOOT0 (" + boot + ") needs a pull-down to GND of at most 10 kOhm")
    for r in touching(b, "capacitor", boot):
        if other_net(b, r, boot) != "GND":
            p.append(r + " couples BOOT0 to " + other_net(b, r, boot))
    others = sorted(
        [r for r in refs_on(b, boot) if r != MCU and r not in downs and r not in touching(b, "capacitor", boot)]
    )
    if others:
        p.append("BOOT0 must be left to its pull-down, but it also reaches " + str(others))
    report(p)


def swd_header(module, inputs):
    # The owner's ST-Link backstop, in his clone ST-Link lead's order: SWD1 pads 1 SWDIO (PA13),
    # 2 GND, 3 SWCLK (PA14), 4 5V_IN (the probe's 5 V pin, into VSYS through D17), no NRST
    # (main2.zen). The pins are checked here by name; the SwdHeader4 symbol maps them to the pads,
    # and tests/test_main2.py checks the pad numbers in the netlist.
    b = index(module)
    p = []
    want = {"GND": "GND", "SWDIO": net(b, MCU, "PA13"), "SWCLK": net(b, MCU, "PA14"), "VDD": "5V_IN"}
    for pin, n in want.items():
        if net(b, "SWD", pin) != n:
            p.append("SWD1 " + pin + " must be on " + n + ", is " + net(b, "SWD", pin))
    report(p)


def nrst_protection(module, inputs):
    # DS13311 Figure 27 p168: 0.1 uF from NRST to VSS; internal pull-up (Table 61).
    b = index(module)
    nrst = net(b, MCU, "NRST")
    report([] if _caps_to_gnd(b, nrst, 100e-9) else ["NRST (" + nrst + ") needs 100 nF to GND"])


def esp_is_the_debug_probe(module, inputs):
    # Research ESP32 radio and A.6: the ESP32-C5 is the debug probe (SWD1 is the ST-Link backstop)
    # and the MCU's link: SWDIO (PA13), SWCLK (PA14) and NRST reach C5 GPIOs (directly or through
    # one series resistor of 220 Ohm or less), so it can connect under reset (AN5419 Figure 21);
    # the SPI2 link, ESP_SCK (PA12, SPI2_SCK), ESP_DATA (PB14, the data line on the MISO pad) and
    # ESP_CSn (PA11), and ESP_Flow (PA9) reach C5 GPIOs too. Each lands on a free pin (FREE),
    # so none of them is a strapping pin or drives the line before the firmware does.
    b = index(module)
    p = []
    esp_nets = {}
    for pin, n in b.parts[ESP].pins.items():
        esp_nets[n.name] = pin
    links = {
        "PA13": "SWDIO",
        "PA14": "SWCLK",
        "NRST": "NRST",
        "PA12": "ESP_SCK (UART4_TX in the fallback)",
        "PB14": "ESP_DATA",
        "PA11": "ESP_CSn (UART4_RX in the fallback)",
        "PA9": "ESP_Flow",
    }
    for mcu_pin, what in links.items():
        m = net(b, MCU, mcu_pin)
        hit = [esp_nets[n] for n in esp_nets if n != "" and series_to(b, m, n, 220)]
        if len(hit) != 1:
            p.append(mcu_pin + " (" + what + ") must reach one ESP32-C5 pin, reaches " + str(hit))
        for pin in hit:
            if pin not in FREE:
                p.append(mcu_pin + " lands on the ESP32-C5's " + pin + ", not a restriction-free pin")
    report(p)


# The link's series resistors: (MCU pin, ohms low, ohms high, the end the layout puts it at).
LINK_RESISTORS = [("PA12", 22, 33, "IC1"), ("PB14", 220, 220, "U13"), ("PA11", 22, 150, "U13")]


def esp_link_series_resistors(module, inputs):
    # A source series resistor on the clock at its driver, PA12 (checklist, SPI: a series resistor
    # on the clock trace; the UART4_TX resistor in the fallback); on the shared data line 220 Ohm
    # against the two drivers overlapping while the direction changes (RM0468 Rev 3 Figure 643
    # note 3: 3.346 V / 218 Ohm = 15.4 mA, under DS13311 Table 11's 20 mA per pin), at the C5; ESP_CSn its UART-fallback TX resistor at the C5 (schematic checklist,
    # UART), and a 100 kOhm pull-up to 3V3_D so the select idles high while nobody drives it. Which
    # end each resistor sits at is the layout's (boards/main2/layout/README.md).
    b = index(module)
    p = []
    for mcu_pin, lo, hi, _end in LINK_RESISTORS:
        m = net(b, MCU, mcu_pin)
        rs = [
            r
            for r in refs_on(b, m)
            if b.parts[r].type == "resistor"
            and other_net(b, r, m) != net(b, MCU, "VDD")
            and ESP in refs_on(b, other_net(b, r, m))
        ]
        if len(rs) != 1 or ohms(b, rs[0]) < lo * 0.99 or ohms(b, rs[0]) > hi * 1.01:
            p.append(
                mcu_pin + " needs one " + str(lo) + "-" + str(hi) + " Ohm resistor to the ESP32-C5, found " + str(rs)
            )
        elif mcu_pin == "PB14" and 3.346 / (ohms(b, rs[0]) * 0.99) > 0.020:
            # both ends driving against each other: 3V3_D's top across the resistor at -1 %
            p.append(rs[0] + " lets " + eng(3.346 / (ohms(b, rs[0]) * 0.99), "A") + " through PB14, above 20 mA")
    cs = net(b, MCU, "PA11")
    ups = [r for r in two_terminal(b, "resistor", cs, net(b, MCU, "VDD")) if abs(ohms(b, r) - 100e3) <= 1e3]
    if len(ups) != 1:
        p.append("ESP_CSn (PA11) needs one 100 kOhm pull-up to 3V3_D, found " + str(ups))
    report(p)


def imu_interrupt_line(module, inputs):
    # DS13476 Rev 5: INT1 (pin 4) alone drives IMU_INT on PB6, push-pull at its defaults; the
    # firmware moves the INT2 interrupts onto it (CTRL4 INT2_on_INT1, Table 58), and INT2 (pin 9),
    # an output forced to ground by default (Table 22), is left open.
    b = index(module)
    p = []
    line = net(b, MCU, "PB6")
    if net(b, "IC2", "INT1") != line:
        p.append("IC2 INT1 must be on PB6's " + line)
    if net(b, "IC2", "INT2") != "":
        p.append("IC2 INT2 must be left open, is on " + net(b, "IC2", "INT2"))
    others = [r for r in refs_on(b, line) if r not in [MCU, "IC2"]]
    if others:
        p.append(line + " carries " + str(others) + "; INT1 drives it alone")
    report(p)


def pin_budget(module, inputs):
    # Research H7 pin budget: every MCU GPIO is used; the two the main board left open carry
    # Motors_nFault (both DRV8874 nFAULT, on PB2) and the ESP32-C5's ESP_Flow (PA9).
    b = index(module)
    p = []
    for pin, n in b.parts[MCU].pins.items():
        if pin[:1] == "P" and pin[1:2] in "ABCDH" and n.name == "":
            p.append("IC1 " + pin + " is unconnected")
    fault = net(b, MCU, "PB2")
    if sorted([r for r in refs_on(b, fault) if r.startswith("IC") and r != MCU]) != ["IC8", "IC9"]:
        p.append("PB2 must carry both DRV8874 nFAULT outputs")
    if ESP not in refs_on(b, net(b, MCU, "PA9")):
        p.append("PA9 must reach the ESP32-C5")
    report(p)


TestBench(
    name="main2_mcu",
    module=MAIN2,
    test_cases={"board": {}},
    checks=[
        direct_smps_core_supply,
        vdd_decoupling,
        vdda_from_the_analog_rail,
        vbat_on_vdd,
        boot0_pulled_down,
        swd_header,
        nrst_protection,
        esp_is_the_debug_probe,
        esp_link_series_resistors,
        imu_interrupt_line,
        pin_budget,
    ],
)
