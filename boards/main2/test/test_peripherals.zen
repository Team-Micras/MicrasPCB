"""The ESP32-C5 module's support circuit U13 and its flashing header J2, the status LEDs and the
buzzer.

Sources: Espressif ESP32-C5-MINI-1 datasheet v1.4 (Tables 4-1, 4-3, 6-2; section 9, Figure 9-1),
the ESP32-C5 hardware design guidelines (schematic checklist) and the ESP-Prog user guide (Program
Interface), Worldsemi WS2812C-2020-V6 V1.1, Fusheng FUET-5030 specification.
"""

load(
    "./helpers.zen",
    "all_two_terminal",
    "eng",
    "farads",
    "index",
    "net",
    "ohms",
    "refs_on",
    "report",
    "touching",
    "two_terminal",
)

MAIN2 = Module("../main2.zen")

ESP = "U13"


def esp_supply_and_enable(module, inputs):
    # Figure 9-1 and section 9: 3V3 decoupled at the module (22 uF + 0.1 uF); EN never floating,
    # with the RC delay "usually R = 10 kOhm and C = 1 uF"; the checklist (Strapping Pins) asks for
    # a pull-up on GPIO28, the boot strap (Tables 4-1, 4-3: low at reset enters the download mode),
    # and no large capacitor on it.
    b = index(module)
    p = []
    v = net(b, ESP, "3V3")
    caps = two_terminal(b, "capacitor", v, "GND")
    if not [r for r in caps if abs(farads(b, r) - 22e-6) <= 2.2e-6] or not [
        r for r in caps if abs(farads(b, r) - 100e-9) <= 10e-9
    ]:
        p.append(v + " needs 22 uF + 100 nF at the ESP32-C5 (Figure 9-1)")
    en, boot = net(b, ESP, "EN"), net(b, ESP, "IO28")
    if not [r for r in two_terminal(b, "resistor", en, v) if abs(ohms(b, r) - 10e3) <= 0.1e3]:
        p.append("EN needs 10 kOhm to 3V3 (section 9)")
    if not [r for r in two_terminal(b, "capacitor", en, "GND") if abs(farads(b, r) - 1e-6) <= 0.1e-6]:
        p.append("EN needs 1 uF to GND (section 9)")
    if not two_terminal(b, "resistor", boot, v):
        p.append("GPIO28 needs a pull-up (schematic checklist, Strapping Pins)")
    for r in two_terminal(b, "capacitor", boot, "GND"):
        if farads(b, r) > 1e-9:
            p.append(r + ": no large capacitor on GPIO28 (schematic checklist)")
    report(p)


# ESP-Prog user guide, Program Interface: 1 ESP_EN, 2 VDD, 3 ESP_TXD, 4 GND, 5 ESP_RXD, 6 ESP_IO0;
# on the C5 the ROM's UART0 is TX0/RX0 (GPIO11/GPIO12) and the boot strap GPIO28 (Table 4-3).
HEADER = "J2"
PROGRAM = {"Pin_1": "EN", "Pin_3": "TX0", "Pin_5": "RX0", "Pin_6": "IO28"}


def esp_flashing_header(module, inputs):
    # The radio flashes and recovers through its ROM's UART download mode: J2 wired as the
    # ESP-Prog's Program interface, its VDD pin on 5V_IN (the programmer's 5 V, into VSYS through
    # D17, REGULATORS sheet; never the module's 3V3), GND on GND.
    b = index(module)
    p = []
    for pin, esp_pin in PROGRAM.items():
        if net(b, HEADER, pin) != net(b, ESP, esp_pin):
            p.append(HEADER + " " + pin + " must be the ESP32-C5's " + esp_pin + ", is " + net(b, HEADER, pin))
    if net(b, HEADER, "Pin_2") != "5V_IN":
        p.append(HEADER + " Pin_2 (VDD) must be 5V_IN, is " + net(b, HEADER, "Pin_2"))
    if net(b, HEADER, "Pin_2") == net(b, ESP, "3V3"):
        p.append(HEADER + " Pin_2 must not be the module's 3V3")
    if net(b, HEADER, "Pin_4") != "GND":
        p.append(HEADER + " Pin_4 must be GND")
    if net(b, "D17", "A") != net(b, HEADER, "Pin_2"):
        p.append(HEADER + " Pin_2 must reach VSYS through D17")
    report(p)


def status_leds_on_3v3(module, inputs):
    # WS2812C-2020-V6 V1.1 p3: VDD 3.3-5.3 V, DI VIH 0.55 x VDD, 100 nF on VDD (p5). The research
    # puts them on 3V3_D (no 5 V rail), driven from PB9.
    b = index(module)
    p = []
    vdd = net(b, "IC1", "VDD")
    for led in ["D1", "D2"]:
        if net(b, led, "VDD") != vdd:
            p.append(led + " VDD is on " + net(b, led, "VDD") + ", not 3V3_D")
    if net(b, "D1", "DI") != net(b, "IC1", "PB9"):
        p.append("D1 DI is not on PB9")
    if net(b, "D2", "DI") != net(b, "D1", "DO"):
        p.append("D1 DO does not chain to D2 DI")
    if len([r for r in two_terminal(b, "capacitor", vdd, "GND") if abs(farads(b, r) - 100e-9) <= 10e-9]) < 2:
        p.append("the LEDs need 100 nF each on VDD")
    report(p)


def buzzer_flyback_diode(module, inputs):
    # FUET-5030 coil buzzer on a low-side switch: a diode across the coil, cathode on the supply.
    b = index(module)
    supply, coil = net(b, "BZ1", "+"), net(b, "BZ1", "-")
    clamps = [r for r in refs_on(b, coil) if r.startswith("D") and net(b, r, "A") == coil and net(b, r, "K") == supply]
    report([] if clamps else ["BZ1 has no flyback diode from " + coil + " to " + supply])


TestBench(
    name="main2_peripherals",
    module=MAIN2,
    test_cases={"board": {}},
    checks=[
        esp_supply_and_enable,
        esp_flashing_header,
        status_leds_on_3v3,
        buzzer_flyback_diode,
    ],
)
