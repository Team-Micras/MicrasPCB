R_20K_0402 = _r("20kOhm 1%", "0402", "0402WGF2002TCE")
R_22K_0402 = _r("22kOhm 1%", "0402", "0402WGF2202TCE")
R_24K_0402 = _r("24kOhm 1%", "0402", "0402WGF2402TCE")
R_33K_0402 = _r("33kOhm 1%", "0402", "0402WGF3302TCE")
R_39K_0402 = _r("39kOhm 1%", "0402", "0402WGF3902TCE")
R_82K_0402 = _r("82kOhm 1%", "0402", "0402WGF8202TCE")
R_100K_0402 = _r("100kOhm 1%", "0402", "0402WGF1003TCE")
R_200K_0402 = _r("200kOhm 1%", "0402", "0402WGF2003TCE")
R_1M_0402 = _r("1MOhm 1%", "0402", "0402WGF1004TCE")
# 0 Ohm jumper, 2512 (25121WJ0000T4E: 1 W, 200 V; LCSC C25469): the alternative of a choke
# footprint. TODO: the jumper's current rating is not in hand (the LCSC listing gives none, the
# Uni-Royal datasheet was not retrieved); the wheel path carries up to 3.6 A peak and 1-1.5 A rms,
# the fan path up to 3.9 A. Confirm it before fitting one, or use the choke.
R_0_2512 = _r("0Ohm", "2512", "25121WJ0000T4E", power="1W")

# Thin-film precision, Yageo RT series (RT datasheet V.16, Table 2: RT0603 1/10 W at 70 C, 75 V;
# 0.1 % with +-25 ppm/C from 1 Ohm): the IR emitter sink sense resistor.
R_1R2_0603_0P1 = _r("1.2Ohm 0.1%", "0603", "RT0603BRD071R2L", manufacturer=YAGEO, power="100mW")

# Current-sense resistor, 1206 alloy, Milliohm HoLLR1206 (LCSC C2988651 listing: 1 W, 25 mOhm
# 1 %, +-50 ppm/C): the fan driver's low-side sense resistor R31.
R_25M_1206 = {
    "value": "25mOhm 1%",
    "package": "1206",
    "mpn": "HoLLR1206-1W-25mR-1%",
    "manufacturer": "Milliohm",
    "power": "1W",
}

