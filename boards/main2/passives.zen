R_100_0402 = _r("100Ohm 1%", "0402", "0402WGF1000TCE")
R_220_0402 = _r("220Ohm 1%", "0402", "0402WGF2200TCE")
R_680_0402 = _r("680Ohm 1%", "0402", "0402WGF6800TCE")
