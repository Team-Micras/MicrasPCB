"""Generic passives of the main2 board: value, package, rating and part number per line.

Each entry is the keyword set of one stdlib generic (`Resistor`, `Capacitor`, `Led`), so a sheet
places a part as `Capacitor(name="C5", P1=GND, P2=VCAP3, **C_100N_0402)`. The parts the board
keeps from boards/main are its MicrasMainBoard BOM parts; the new ones are JLCPCB basic parts
where one fits. The LCSC numbers, library types and their sources are in parts/jlc.toml.
"""

SAMSUNG = "Samsung Electro-Mechanics"
UNIROYAL = "UNI-ROYAL"
FENGHUA = "Fenghua"
MURATA = "Murata"
YAGEO = "YAGEO"


def _r(value, package, mpn, manufacturer=UNIROYAL, power=None):
    out = {"value": value, "package": package, "mpn": mpn, "manufacturer": manufacturer}
    if power:
        out["power"] = power
    return out


def _c(value, package, voltage, dielectric, mpn, manufacturer=SAMSUNG):
    return {
        "value": value,
        "package": package,
        "voltage": voltage,
        "dielectric": dielectric,
        "mpn": mpn,
        "manufacturer": manufacturer,
    }


# Thick-film chip resistors, 1 %: 0402 62.5 mW 50 V, 0603 100 mW 75 V, 1206 250 mW 200 V, 2512 1 W
# 200 V (LCSC listings of each part).
R_0_0402 = _r("0Ohm", "0402", "0402WGF0000TCE")
R_3R3_0603 = _r("3.3Ohm 1%", "0603", "0603WAF330KT5E", power="100mW")
R_10_1206 = _r("10Ohm 1%", "1206", "1206W4F100JT5E", power="250mW")
