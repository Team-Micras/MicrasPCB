(version 1)

# JLCPCB rigid FR-4, 1 oz outer copper, 2-layer and 4-layer standard service.
# Limits from rules/jlcpcb-pdk.toml (Diode's sourced JLCPCB PDK, revision advisory-mask-2026-09-29,
# from https://jlcpcb.com/capabilities/pcb-capabilities). Errors sit at the capability minimum;
# warnings sit at the preferred value, so the board stays in JLC's cheapest process.
#
# Source of truth for every board: `micras-pcb rules` copies this file next to each .kicad_pro
# (as <board>.kicad_dru) and `micras-pcb rules --check` fails CI if a copy drifts.

(rule "jlc: copper clearance"
	(constraint clearance (min 0.10mm)))

(rule "jlc: track width"
	(condition "A.Type == 'Track'")
	(constraint track_width (min 0.10mm)))

(rule "jlc: copper to board edge"
	(constraint edge_clearance (min 0.20mm)))

(rule "jlc: via hole"
	(condition "A.Type == 'Via'")
	(constraint hole_size (min 0.15mm)))

(rule "jlc: via hole (preferred)"
	(severity warning)
	(condition "A.Type == 'Via'")
	(constraint hole_size (min 0.20mm)))

# JLCPCB charges for a 0.2 or 0.25 mm via hole whose copper is under 0.45 mm across ("0.2mm or 0.25mm
# hole size with via diameter less than 0.45mm, will cost more", capabilities page); every board's
# vias are 0.45 mm and up (spec/<board>.toml pcb.via_diameter), JLCPCB's free class.
(rule "jlc: via diameter (free class)"
	(severity warning)
	(condition "A.Type == 'Via'")
	(constraint via_diameter (min 0.45mm)))

(rule "jlc: via annular ring"
	(condition "A.Type == 'Via'")
	(constraint annular_width (min 0.05mm)))

(rule "jlc: via annular ring (preferred)"
	(severity warning)
	(condition "A.Type == 'Via'")
	(constraint annular_width (min 0.075mm)))

(rule "jlc: PTH hole"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
	(constraint hole_size (min 0.15mm)))

(rule "jlc: NPTH hole"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical'")
	(constraint hole_size (min 0.50mm)))

(rule "jlc: PTH annular ring, 2-layer"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && A.isPlated()")
	(layer outer)
	(constraint annular_width (min 0.18mm)))

# Per-object clearances from the same capabilities page ("Traces" table, read 2026-10-14):
# SMD pad to pad (different nets) 0.15 mm; PTH to track 0.28 mm min, 0.35 mm recommended;
# NPTH to track 0.2 mm; via hole to track 0.2 mm; inner-layer PTH hole to copper 0.3 mm and
# via hole to copper 0.2 mm. The page lists "pad to track 0.1 mm" separately, so the hole rows
# are read as drilled-hole edge to copper (KiCad hole_clearance).

(rule "jlc: SMD pad to pad"
	(condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Pad_Type == 'SMD' && B.Pad_Type == 'SMD'")
	(constraint clearance (min 0.15mm)))

(rule "jlc: PTH hole to track"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && (B.Type == 'Track' || B.Type == 'Arc')")
	(constraint hole_clearance (min 0.28mm)))

(rule "jlc: PTH hole to track (preferred)"
	(severity warning)
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && (B.Type == 'Track' || B.Type == 'Arc')")
	(constraint hole_clearance (min 0.35mm)))

(rule "jlc: NPTH hole to track"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical' && (B.Type == 'Track' || B.Type == 'Arc')")
	(constraint hole_clearance (min 0.20mm)))

(rule "jlc: via hole to track"
	(condition "A.Type == 'Via' && (B.Type == 'Track' || B.Type == 'Arc')")
	(constraint hole_clearance (min 0.20mm)))

(rule "jlc: inner-layer PTH hole to copper"
	(layer inner)
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
	(constraint hole_clearance (min 0.30mm)))

(rule "jlc: inner-layer via hole to copper"
	(layer inner)
	(condition "A.Type == 'Via'")
	(constraint hole_clearance (min 0.20mm)))

(rule "jlc: hole to hole, via to via"
	(condition "A.Type == 'Via' && B.Type == 'Via'")
	(constraint hole_to_hole (min 0.20mm)))

(rule "jlc: hole to hole"
	(condition "!(A.Type == 'Via' && B.Type == 'Via')")
	(constraint hole_to_hole (min 0.45mm)))

# Pours keep 10 um over the 0.20 mm routed-edge clearance ("Outline" table: copper clearance from
# routed board edges >= 0.2 mm): zone fills approximate arcs with segments, within KiCad's 5 um
# maximum error, which would otherwise eat into the 0.20 mm (seen at the encoder tab reliefs by
# `micras-pcb dfm`). The previous boards' Altium pours sit 0.19-0.23 mm from the edge.
(rule "pours: copper to board edge"
	(condition "A.Type == 'Zone'")
	(constraint edge_clearance (min 0.21mm)))

# The inner planes keep 0.5 mm from every routed edge (the outline, the fan hole, the slots):
# JLCPCB mills edges to +-0.2 mm (regular; "Dimension tolerance for routed board edges",
# jlcpcb.com/capabilities/pcb-capabilities), so a plane at the 0.2 mm minimum may be cut open, its
# copper exposed in the edge beside the outer layers' (team review 2026-11-08, owner's choice). The
# outer layers' pours and tracks keep the 0.20/0.21 mm minimum above; a plane loses only a 0.3 mm
# strip. (The pours are single-layer zones; KiCad's edge test does not honour a (layer inner)
# clause, so the condition names the layers.)
(rule "pours: inner planes to board edge"
	(condition "A.Type == 'Zone' && (A.Layer == 'In1.Cu' || A.Layer == 'In2.Cu')")
	(constraint edge_clearance (min 0.50mm)))

# The main board's hand-soldered ground pins (the wall joints' pin 2, SWD1 pin 3, J2 pin 4, J3 pin 1)
# join the pours by their zones' thermal reliefs on B.Cu and the inner planes (0.25 mm gap; boards/
# main/layout/route.py relief() gives them 0.4 mm spokes: JLCPCB's thermal relief guide, 0.30-0.50 mm for
# through-hole pads), so a soldering iron heats the joint instead of the planes, one spoke enough
# where the pour reaches a pad from one side; solid on F.Cu, which the pour reaches from one side
# only (the pads inherit these rules). No other board has a ground pad on these references.
(rule "main: hand-soldered ground pins, reliefs"
	(condition "A.Type == 'Pad' && A.NetName == 'GND' && (A.memberOfFootprint('W1') || A.memberOfFootprint('W2') || A.memberOfFootprint('W3') || A.memberOfFootprint('W4') || A.memberOfFootprint('SWD1') || A.memberOfFootprint('J2') || A.memberOfFootprint('J3'))")
	(constraint min_resolved_spokes 1))
(rule "main: hand-soldered ground pins, solid on F.Cu"
	(layer F.Cu)
	(condition "A.Type == 'Pad' && A.NetName == 'GND' && (A.memberOfFootprint('W1') || A.memberOfFootprint('W2') || A.memberOfFootprint('W3') || A.memberOfFootprint('W4') || A.memberOfFootprint('SWD1') || A.memberOfFootprint('J2') || A.memberOfFootprint('J3'))")
	(constraint zone_connection solid))

# The main board's small parts whose pour pad the pour reaches from one side (route.py ONE_SPOKE):
# one 0.2 mm spoke is their join, so the pad heats as fast as the other pad on its thin track in
# reflow (no tombstoning).
(rule "main: one-spoke pads"
	(condition "A.Type == 'Pad' && A.Pad_Number == '1' && (A.NetName == 'GND' || A.NetName == 'GND_BAT' || A.NetName == 'VBAT') && (A.memberOfFootprint('R2') || A.memberOfFootprint('D4') || A.memberOfFootprint('C30') || A.memberOfFootprint('R30') || A.memberOfFootprint('C58') || A.memberOfFootprint('R41') || A.memberOfFootprint('R44'))")
	(constraint min_resolved_spokes 1))
