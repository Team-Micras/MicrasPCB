R_140K_0402 = _r("140kOhm 1%", "0402", "0402WGF1403TCE")
R_68K_0603 = _r("68kOhm 1%", "0603", "0603WAF6802T5E", power="100mW")
R_1M_0603 = _r("1MOhm 1%", "0603", "0603WAF1004T5E", power="100mW")

# Current-sense shunts, 2512.
R_50M_2512 = _r("50mOhm 1%", "2512", "HoLLR2512-3W-50mR-1%", manufacturer="Milliohm", power="3W")
R_40M_2512 = _r("40mOhm 1%", "2512", "LR2512-22R040F4", manufacturer="RALEC", power="2W")

