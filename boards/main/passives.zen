"""Generic passives of the main board: value, package, rating and part number per line.

Each entry is the keyword set of one stdlib generic (`Resistor`, `Capacitor`, `Led`), so a sheet
places a part as `Capacitor(name="C5", P1=GND, P2=VCAP3, **C_100N_0402)`. The ratings and part
numbers are the MicrasMainBoard BOM's parts (boards/main/previous/board.json) or JLCPCB basic
parts; the LCSC numbers are in parts/jlc.toml.
"""

SAMSUNG = "Samsung Electro-Mechanics"
UNIROYAL = "UNI-ROYAL"
FENGHUA = "Fenghua"
MURATA = "Murata"


def _r(value, package, mpn, manufacturer=UNIROYAL, power=None):
    out = {"value": value, "package": package, "mpn": mpn, "manufacturer": manufacturer}
    if power:
        out["power"] = power
    return out


def _c(value, package, voltage, dielectric, mpn, manufacturer=SAMSUNG):
    return {
        "value": value,
        "package": package,
        "voltage": voltage,
        "dielectric": dielectric,
        "mpn": mpn,
        "manufacturer": manufacturer,
    }


# Thick-film chip resistors, 1 %: 0402 62.5 mW 50 V, 0603 100 mW 75 V, 1206 250 mW 200 V.
R_0_0402 = _r("0Ohm", "0402", "0402WGF0000TCE")
R_10_1206 = _r("10Ohm 1%", "1206", "1206W4F100JT5E", power="250mW")
R_100_0402 = _r("100Ohm 1%", "0402", "0402WGF1000TCE")
R_220_0402 = _r("220Ohm 1%", "0402", "0402WGF2200TCE")
R_680_0402 = _r("680Ohm 1%", "0402", "0402WGF6800TCE")
