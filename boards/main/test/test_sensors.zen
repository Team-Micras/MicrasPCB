"""Wall-emitter drive: the wall joints W1-W4 (each wall board carries its emitter, its resistor and
its AC-coupled selector, boards/wall and its bench) and the shared sink U12/Q9 with its DAC
set-point.

Sources: ams-OSRAM SFH 4550 v1.9 (p4: IF 100 mA DC max) and v1.8 (p.6: pulse handling), AOS AO3400A Rev 3.1 (p2), TI SBOS833R
(TLV9001, section 7.10), ST DS13311 Rev 5 (Table 90, DAC); the model
research/next-revision/calculations/emitter/emitter_sink.py (emitter_sink_out.txt).
"""

load(
    "./helpers.zen",
    "eng",
    "index",
    "net",
    "ohms",
    "report",
    "two_terminal",
)

MAIN = Module("../main.zen")

MCU = "IC1"
SINK_AMP = "U12"
SINK_FET = "Q9"
SENSE = "R83"
# Emitter n's selector is driven from a TIM3 channel (boards/main/firmware_changes.toml, emitters):
# PC9 CH4, PB0 CH3, PB5 CH2 (W3), PB4 CH1 (W4).
CHANNELS = [("W1", "PC9"), ("W2", "PB0"), ("W3", "PB5"), ("W4", "PB4")]
# Each receiver's load at the ADC (Sensors.zen, Receiver n; the v1 board's 1 kOhm).
R_LOAD = 1e3
# DAC1_OUT2 with the buffer off: 0 V to VREF+ through RO 10.3-16 kOhm (DS13311 Table 90).
RO = [10.3e3, 16e3]
VREF = 3.3
VOS_MAX = 2e-3  # TLV9001 input offset, -40 to 125 C (SBOS833R 7.10)
# VDDA (= VREF+) and 3V3_D extremes: ADP7142 Rev H Table 1 (3.36 V max), L6981C33 DS13554 Table 6
# (3.346 V max); 3V3_D at an emitter pulse, 3.229 V: its 3.284 V minimum less the emitter droop and
# an ESP32 dip (Sensors.zen, research power-tree study section 6).
VDDA_MAX = 3.36
V3V3_D_MAX = 3.346
V3V3_D_PULSE_MIN = 3.229
# SFH 4550 (WallSensor.zen): VF max 1.79 V at 175 mA (between the p5 maximum points); the chord
# through the typical points 1.5 V at 100 mA and 2.4 V at 1 A, VF = 1.4 V + 1 Ohm x I, lies below
# the (concave) VF curve, so it overstates a fault current.
VF_MAX_SET = 1.79
I_SET = 0.175
VF0, RF = 1.4, 1.0
# The sink's drain at the set current: the 0.21 V across R83 plus Q9 at RDS(on) 48 mOhm max (AO3400A
# p2). What is left is the selector's: a source follower whose gate ends a pulse at 2.50 V, so the
# headroom is its margin against VGS(175 mA) (emitter_sink_out.txt section 1 models it); 0.5 V is
# the floor this check holds.
SINK_FLOOR = 0.21 + I_SET * 0.048
HEADROOM_MIN = 0.5


def wall_joints_carry_the_drive(module, inputs):
    # Each joint's PWM pin is its TIM3 channel (the wall board's selector gate network), its SINK
    # pin the shared sink's drain (Q9 D, the selector's source), its OUT the receiver's ADC line
    # with its 1 kOhm load to GND here, and its supplies 3V3_D (emitter) and 3V3_A (receiver).
    b = index(module)
    p = []
    sink = net(b, SINK_FET, "D")
    for sensor, pin in CHANNELS:
        if net(b, sensor, "PWM") != net(b, MCU, pin):
            p.append(sensor + " PWM is on " + net(b, sensor, "PWM") + ", not " + pin + "'s " + net(b, MCU, pin))
        if net(b, sensor, "SINK") != sink:
            p.append(sensor + " SINK is on " + net(b, sensor, "SINK") + ", not " + SINK_FET + "'s drain " + sink)
        out = net(b, sensor, "OUT")
        loads = [r for r in two_terminal(b, "resistor", out, "GND") if abs(ohms(b, r) - R_LOAD) <= 0.01 * R_LOAD]
        if len(loads) != 1:
            p.append(sensor + " OUT (" + out + ") needs one 1 kOhm load to GND, found " + str(loads))
        if net(b, sensor, "GND") != "GND":
            p.append(sensor + " GND is not GND")
        if net(b, sensor, "3V3_D") != net(b, "IC1", "VDD"):
            p.append(sensor + " 3V3_D is not the MCU's 3V3_D")
        if net(b, sensor, "3V3_A") != net(b, SINK_AMP, "V+"):
            p.append(sensor + " 3V3_A is not the sink's (and the ADC reference's) 3V3_A")
    report(p)


def emitter_sink_set_point_from_the_dac(module, inputs):
    # IN+ divides PA5 (DAC1_OUT2) down, with a resistor to GND that holds it at 0 V while the DAC
    # is off; IN- sits behind a resistor from the sense node, with a capacitor from OUT and a bias
    # from 3V3_A beyond twice the op-amp's offset, so a zero set-point turns Q9 off. Full scale
    # reaches the 175 mA design point at the highest RO.
    b = index(module)
    p = []
    inp, inn, out = net(b, SINK_AMP, "+"), net(b, SINK_AMP, "-"), net(b, SINK_AMP, "OUT")
    dac, sense, va = net(b, MCU, "PA5"), net(b, SINK_FET, "S"), net(b, SINK_AMP, "V+")
    top, bottom = two_terminal(b, "resistor", dac, inp), two_terminal(b, "resistor", inp, "GND")
    fb, cc, bias = (
        two_terminal(b, "resistor", sense, inn),
        two_terminal(b, "capacitor", out, inn),
        two_terminal(b, "resistor", va, inn),
    )
    if len(top) != 1 or len(bottom) != 1:
        p.append(SINK_AMP + " IN+ needs one resistor from PA5 and one to GND, found " + str(top) + " " + str(bottom))
    if len(fb) != 1 or len(cc) != 1 or len(bias) != 1:
        p.append(SINK_AMP + " IN- needs a resistor from " + sense + ", a capacitor from OUT and a bias from " + va)
    if va != net(b, MCU, "VDDA") and va != net(b, "R67", "1") and va != net(b, "R67", "2"):
        p.append(SINK_AMP + " is not on the ADC reference's rail")
    if not p:
        rf = ohms(b, fb[0])
        offset = VREF * rf / (ohms(b, bias[0]) + rf)
        if offset < 2 * VOS_MAX:
            p.append(bias[0] + " biases IN- by " + str(offset * 1e3) + " mV, below twice the 2 mV offset")
        k = ohms(b, bottom[0]) / (ohms(b, top[0]) + ohms(b, bottom[0]) + RO[1])
        rb = ohms(b, bias[0])
        full = (VREF * k * (1 + rf / rb) - VREF * rf / rb) / ohms(b, SENSE)
        if full < 0.175 or full > 0.3:
            p.append("full-scale emitter current " + str(full * 1e3) + " mA at RO 16 kOhm, outside 175-300 mA")
    report(p)


def emitter_pulse_within_rating(module, inputs):
    # SFH 4550 pulse handling (WallSensor.zen and WallJoint.zen, emitter_pulse_current: tp <= 150 us, D <= 0.2, 25 C;
    # the firmware lights each emitter 150 us per 1 ms frame, boards/main/firmware_changes.toml):
    # - the DAC's full scale (code 4095, VREF+ at VDDA max, RO at its 10.3 kOhm minimum) stays within it;
    # - so does a failed sink (Q9 shorted or U12 stuck high), which leaves only the emitter resistor and
    #   R83 to limit the current, at 3V3_D max;
    # - and the emitter resistor leaves the selector its headroom at VF max and 3V3_D at its minimum.
    b = index(module)
    p = []
    inp, inn = net(b, SINK_AMP, "+"), net(b, SINK_AMP, "-")
    dac, sense, va = net(b, MCU, "PA5"), net(b, SINK_FET, "S"), net(b, SINK_AMP, "V+")
    top, bottom = two_terminal(b, "resistor", dac, inp), two_terminal(b, "resistor", inp, "GND")
    fb, bias = two_terminal(b, "resistor", sense, inn), two_terminal(b, "resistor", va, inn)
    if len(top) != 1 or len(bottom) != 1 or len(fb) != 1 or len(bias) != 1:
        report(["the sink's set-point divider or feedback is not where emitter_sink_set_point_from_the_dac expects"])
        return
    rf, rb, rs = ohms(b, fb[0]), ohms(b, bias[0]), ohms(b, SENSE)
    k = ohms(b, bottom[0]) / (ohms(b, top[0]) + ohms(b, bottom[0]) + RO[0])
    full = VDDA_MAX * (k * (1 + rf / rb) - rf / rb) / rs
    for sensor, pin in CHANNELS:
        # The emitter and its resistor sit on the wall board (boards/wall, its W1 and R1); the joint
        # carries their values (components/micras/WallJoint; tests/test_wall.py compares them).
        rating = b.parts[sensor].emitter_pulse_current.value
        re = b.parts[sensor].emitter_resistor.value
        r_name = sensor + "'s wall board R1"
        if full > rating:
            p.append(
                sensor
                + ": full-scale sink current "
                + eng(full, "A")
                + " above the "
                + eng(rating, "A")
                + " pulse rating"
            )
        fault = (V3V3_D_MAX - VF0) / (re + rs + RF)
        if fault > rating:
            p.append(
                sensor
                + ": a failed sink lets "
                + eng(fault, "A")
                + " through "
                + r_name
                + " "
                + eng(re, "Ohm")
                + " and "
                + SENSE
                + ", above the "
                + eng(rating, "A")
                + " pulse rating"
            )
        headroom = V3V3_D_PULSE_MIN - VF_MAX_SET - I_SET * re - SINK_FLOOR
        if headroom < HEADROOM_MIN:
            p.append(sensor + ": " + r_name + " leaves the selector " + eng(headroom, "V") + ", below 0.5 V")
    report(p)


TestBench(
    name="main_sensors",
    module=MAIN,
    test_cases={"board": {}},
    checks=[
        wall_joints_carry_the_drive,
        emitter_sink_set_point_from_the_dac,
        emitter_pulse_within_rating,
    ],
)
